      "settings": {
        "custom_liquid": "<!-- Zambelli Colors + Size Guide (Sales Section)\n     Paste into a Custom Liquid block or HTML section.\n     Notes:\n     - Uses simple CSS (no dependencies)\n     - Mobile-friendly grid\n     - Clickable \"cards\" pattern (swap links + images)\n-->\n\n<section class=\"zam-section\" aria-label=\"Zambelli color selector and size guide\">\n  <div class=\"zam-wrap\">\n\n    <!-- HERO -->\n    <header class=\"zam-hero\">\n      <h1 class=\"zam-h1\">Zambelli European Painted Steel Half-Round Gutter Systems</h1>\n      <p class=\"zam-sub\">\n        Precision-engineered, no-sealant gutter systems available in premium European colors — designed to install faster and last for decades.\n      </p>\n    </header>\n\n    <!-- COLOR SELECTOR -->\n    <div class=\"zam-block\">\n      <div class=\"zam-block-head\">\n        <h2 class=\"zam-h2\">Choose a Color</h2>\n        <p class=\"zam-help\">Select a color to view compatible Zambelli gutter components.</p>\n      </div>\n\n      <div class=\"zam-grid\" role=\"list\">\n        <!-- Card 1 -->\n        <a class=\"zam-card\" role=\"listitem\" href=\"#\" aria-label=\"Shop Zambelli in Black\">\n          <div class=\"zam-img\">\n            <img src=\"YOUR-BLACK-IMAGE.jpg\" alt=\"Zambelli painted steel half-round gutter in black\">\n            <span class=\"zam-overlay\" aria-hidden=\"true\">Shop this color</span>\n          </div>\n          <div class=\"zam-card-meta\">\n            <div class=\"zam-title\">Black</div>\n            <div class=\"zam-cta\">View system →</div>\n          </div>\n        </a>\n\n        <!-- Card 2 -->\n        <a class=\"zam-card\" role=\"listitem\" href=\"#\" aria-label=\"Shop Zambelli in Dark Bronze\">\n          <div class=\"zam-img\">\n            <img src=\"YOUR-DARK-BRONZE-IMAGE.jpg\" alt=\"Zambelli painted steel half-round gutter in dark bronze\">\n            <span class=\"zam-overlay\" aria-hidden=\"true\">Shop this color</span>\n          </div>\n          <div class=\"zam-card-meta\">\n            <div class=\"zam-title\">Dark Bronze</div>\n            <div class=\"zam-cta\">View system →</div>\n          </div>\n        </a>\n\n        <!-- Card 3 -->\n        <a class=\"zam-card\" role=\"listitem\" href=\"#\" aria-label=\"Shop Zambelli in Dark Charcoal\">\n          <div class=\"zam-img\">\n            <img src=\"YOUR-DARK-CHARCOAL-IMAGE.jpg\" alt=\"Zambelli painted steel half-round gutter in dark charcoal\">\n            <span class=\"zam-overlay\" aria-hidden=\"true\">Shop this color</span>\n          </div>\n          <div class=\"zam-card-meta\">\n            <div class=\"zam-title\">Dark Charcoal</div>\n            <div class=\"zam-cta\">View system →</div>\n          </div>\n        </a>\n\n        <!-- Card 4 -->\n        <a class=\"zam-card\" role=\"listitem\" href=\"#\" aria-label=\"Shop Zambelli in Antique White\">\n          <div class=\"zam-img\">\n            <img src=\"YOUR-ANTIQUE-WHITE-IMAGE.jpg\" alt=\"Zambelli painted steel half-round gutter in antique white\">\n            <span class=\"zam-overlay\" aria-hidden=\"true\">Shop this color</span>\n          </div>\n          <div class=\"zam-card-meta\">\n            <div class=\"zam-title\">Antique White</div>\n            <div class=\"zam-cta\">View system →</div>\n          </div>\n        </a>\n\n        <!-- Card 5 -->\n        <a class=\"zam-card\" role=\"listitem\" href=\"#\" aria-label=\"Shop Zambelli in Natural Gray Metallic\">\n          <div class=\"zam-img\">\n            <img src=\"YOUR-NAT-GRAY-IMAGE.jpg\" alt=\"Zambelli painted steel half-round gutter in natural gray metallic\">\n            <span class=\"zam-overlay\" aria-hidden=\"true\">Shop this color</span>\n          </div>\n          <div class=\"zam-card-meta\">\n            <div class=\"zam-title\">Nat. Gray Metallic</div>\n            <div class=\"zam-cta\">View system →</div>\n          </div>\n        </a>\n      </div>\n    </div>\n\n    <!-- WHY ZAMBELLI -->\n    <div class=\"zam-block zam-why\">\n      <h2 class=\"zam-h2\">Why Choose Zambelli</h2>\n      <ul class=\"zam-bullets\">\n        <li><strong>No caulking or sealants</strong> — mechanically sealed connections reduce long-term leak points.</li>\n        <li><strong>Faster installation</strong> — fewer steps, less cleanup, and a clean system fit.</li>\n        <li><strong>Painted steel durability</strong> — strong, rigid components with a refined architectural finish.</li>\n        <li><strong>System-matched compatibility</strong> — each size uses dedicated components engineered to work together.</li>\n      </ul>\n    </div>\n\n    <!-- SIZE GUIDE -->\n    <div class=\"zam-block zam-sizes\">\n      <div class=\"zam-block-head\">\n        <h2 class=\"zam-h2\">Choosing the Right Zambelli Gutter Size</h2>\n        <p class=\"zam-help\">Quick guidance to help pick the right system. Each size uses dedicated Zambelli components.</p>\n      </div>\n\n      <div class=\"zam-size-grid\">\n        <div class=\"zam-size\">\n          <div class=\"zam-size-top\">\n            <h3 class=\"zam-h3\">5″ System <span class=\"zam-mm\">(280 mm)</span></h3>\n          </div>\n          <ul class=\"zam-size-list\">\n            <li>Smaller residential homes</li>\n            <li>Shorter roof runs</li>\n            <li>Compact appearance</li>\n          </ul>\n          <a class=\"zam-btn\" href=\"#\">Shop 5″ System</a>\n        </div>\n\n        <div class=\"zam-size zam-feature\">\n          <div class=\"zam-pill\" aria-hidden=\"true\">Most Popular</div>\n          <div class=\"zam-size-top\">\n            <h3 class=\"zam-h3\">6″ System <span class=\"zam-mm\">(333 mm)</span></h3>\n          </div>\n          <ul class=\"zam-size-list\">\n            <li>Larger homes & multi-story roofs</li>\n            <li>Higher water capacity</li>\n            <li>Balanced architectural profile</li>\n          </ul>\n          <a class=\"zam-btn\" href=\"#\">Shop 6″ System</a>\n        </div>\n\n        <div class=\"zam-size\">\n          <div class=\"zam-size-top\">\n            <h3 class=\"zam-h3\">7.6″ System <span class=\"zam-mm\">(400 mm)</span></h3>\n          </div>\n          <ul class=\"zam-size-list\">\n            <li>Large roofs & architectural projects</li>\n            <li>Maximum water handling</li>\n            <li>Bold European appearance</li>\n          </ul>\n          <a class=\"zam-btn\" href=\"#\">Shop 7.6″ System</a>\n        </div>\n      </div>\n\n      <p class=\"zam-note\">\n        <strong>Not sure which size is right?</strong> Contact our team — we’ll help you select the correct Zambelli system before ordering.\n      </p>\n\n      <p class=\"zam-note zam-note-small\">\n        Zambelli systems are engineered as complete systems. Mixing sizes or brands is not recommended.\n      </p>\n    </div>\n\n    <!-- FINAL CTA -->\n    <div class=\"zam-final\">\n      <a class=\"zam-bigcta\" href=\"#zam-colors\">Choose a color above to view compatible Zambelli components →</a>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .zam-section { padding: 40px 0; }\n  .zam-wrap { width: min(1150px, 92%); margin: 0 auto; }\n  .zam-hero { text-align: center; padding: 10px 0 24px; }\n  .zam-h1 { font-size: clamp(26px, 3vw, 38px); margin: 0 0 10px; line-height: 1.15; }\n  .zam-sub { max-width: 820px; margin: 0 auto; color: #5b5b5b; font-size: 16px; line-height: 1.5; }\n\n  .zam-block { margin: 28px 0; }\n  .zam-block-head { text-align: center; margin-bottom: 14px; }\n  .zam-h2 { font-size: clamp(20px, 2.2vw, 28px); margin: 0 0 6px; }\n  .zam-help { margin: 0; color: #6a6a6a; }\n\n  /* COLOR GRID */\n  .zam-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 16px; }\n  @media (max-width: 1050px) { .zam-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }\n  @media (max-width: 720px) { .zam-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }\n\n  .zam-card { display: block; text-decoration: none; color: inherit; border: 1px solid #e7e7e7; border-radius: 12px; background: #fafafa; overflow: hidden; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }\n  .zam-card:focus { outline: 3px solid rgba(0,0,0,.18); outline-offset: 2px; }\n  .zam-card:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(0,0,0,.10); border-color: #d8d8d8; }\n\n  .zam-img { position: relative; background: #fff; aspect-ratio: 16 / 10; display: grid; place-items: center; }\n  .zam-img img { max-width: 92%; max-height: 92%; transition: transform .18s ease; }\n  .zam-card:hover .zam-img img { transform: scale(1.04); }\n\n  .zam-overlay { position: absolute; inset: auto 12px 12px 12px; text-align: center; padding: 8px 10px; border-radius: 10px; background: rgba(0,0,0,.72); color: #fff; font-weight: 600; font-size: 13px; opacity: 0; transform: translateY(6px); transition: opacity .18s ease, transform .18s ease; }\n  .zam-card:hover .zam-overlay { opacity: 1; transform: translateY(0); }\n\n  .zam-card-meta { padding: 12px 14px 14px; text-align: center; }\n  .zam-title { font-weight: 700; }\n  .zam-cta { margin-top: 6px; font-size: 13px; color: #4b4b4b; }\n\n  /* WHY */\n  .zam-why { border: 1px solid #eee; border-radius: 14px; padding: 18px 18px 10px; background: #fff; }\n  .zam-bullets { margin: 10px 0 0; padding-left: 18px; color: #3f3f3f; }\n  .zam-bullets li { margin: 10px 0; line-height: 1.5; }\n\n  /* SIZE GRID */\n  .zam-size-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; align-items: stretch; }\n  @media (max-width: 900px) { .zam-size-grid { grid-template-columns: 1fr; } }\n\n  .zam-size { position: relative; border: 1px solid #e7e7e7; border-radius: 14px; background: #fff; padding: 16px; }\n  .zam-feature { border-color: #cfcfcf; box-shadow: 0 14px 28px rgba(0,0,0,.08); }\n  .zam-pill { position: absolute; top: 12px; right: 12px; font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 999px; background: #111; color: #fff; }\n\n  .zam-h3 { margin: 0 0 10px; font-size: 18px; }\n  .zam-mm { font-weight: 600; color: #6a6a6a; font-size: 14px; }\n\n  .zam-size-list { margin: 0; paddin",
