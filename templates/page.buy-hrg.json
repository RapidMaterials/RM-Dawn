.zam-size-wrap { width: min(1100px, 92%); margin: 0 auto; }\n\n  .zam-size-header { text-align: center; margin-bottom: 18px; }\n  .zam-size-h2 { font-size: clamp(22px, 2.4vw, 30px); margin-bottom: 6px; }\n  .zam-size-sub { color: #666; max-width: 760px; margin: 0 auto; }\n\n  .zam-size-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0,1fr));\n    gap: 16px;\n  }\n  @media (max-width: 900px) {\n    .zam-size-grid { grid-template-columns: 1fr; }\n  }\n\n  .zam-size-card {\n    position: relative;\n    border: 1px solid #e6e6e6;\n    border-radius: 14px;\n    padding: 18px;\n    background: #fff;\n  }\n\n  .zam-featured {\n    border-color: #cfcfcf;\n    box-shadow: 0 14px 28px rgba(0,0,0,.08);\n  }\n\n  .zam-pill {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    background: #111;\n    color: RogersWhite;\n    font-size: 12px;\n    font-weight: 700;\n    padding: 6px 10px;\n    border-radius: 999px;\n  }\n\n  .zam-size-h3 {\n    font-size: 18px;\n    margin-bottom: 10px;\n  }\n  .zam-size-h3 span {\n    font-weight: 500;\n    color: #666;\n    font-size: 14px;\n  }\n\n  .zam-size-card ul {\n    padding-left: 18px;\n    margin: 0 0 14px;\n    color: #333;\n  }\n  .zam-size-card li {\n    margin: 8px 0;\n  }\n\n  .zam-size-btn {\n    display: block;\n    text-align: center;\n    padding: 10px 12px;\n    border-radius: 10px;\n    border: 1px solid #ddd;\n    background: #f7f7f7;\n    font-weight: 700;\n    text-decoration: none;\n    color: #111;\n    transition: transform .15s ease, box-shadow .15s ease;\n  }\n  .zam-size-btn:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 10px 18px rgba(0,0,0,.08);\n  }\n\n  .zam-size-note {\n    text-align: center;\n    margin-top: 16px;\n    color: #444;\n  }\n</style>",
