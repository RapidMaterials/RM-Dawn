          "type": "column",
          "settings": {
            "title": "<strong> Faster, Easier Installation</strong>",
            "text": "<p>Pre-assembled components, automatic electrical bonding, and one-tool installation slash labor time by 30-50%. Installers can quickly locate modules without worrying about rail alignment, resulting in quicker, more flexible layouts.</p>",
            "link_label": "",
            "link": "https://cdn.shopify.com/s/files/1/0645/2540/2290/files/ColorGard-2-0-Installation-Instructions_RapidMaterials.pdf?v=1743440011"
