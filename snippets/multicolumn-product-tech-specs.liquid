{%- assign certs = product.metafields.custom.certifications.value -%}
{%- assign roofprofs = product.metafields.custom.roof_profiles.value -%}

<div class="specs" style="padding: 16px; background-color: #f5f5f5; margin-top: 20px;">
  <h3 style="font-weight: bold; margin-bottom: 8px;">Specs</h3>
  <ul style="list-style: none; padding: 0; margin: 0;">
    <li><strong>SKU:</strong> <span class="js-variant-sku">{{ product.selected_or_first_available_variant.sku }}</span></li>
    {%- if product.selected_or_first_available_variant.barcode != blank -%}
      <li><strong>UPC:</strong> {{ product.selected_or_first_available_variant.barcode }}</li>
    {%- endif -%}

    {%- if certs != blank -%}
      <li><strong>Certifications:</strong>
        <div class="certs-box" style="display: flex; gap: 4px; flex-wrap: wrap; align-items: end;">
          {%- for certifications in certs -%}
            <div class="indv-cert">
              {%- if certifications.document != blank -%}
                <a href="{{ certifications.document.value.url }}" style="text-decoration: none; color: inherit;">
              {%- endif -%}

              {%- if certifications.icon != blank -%}
                <img src="{{ certifications.icon | image_url: width: 32 }}" alt="{{ certifications.name.value }} Icon" style="display: block; margin: 0 auto 5px;">
              {%- endif -%}

              {{ certifications.name.value }}

              {%- if certifications.document != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </li>
    {%- endif -%}

    {%- if roofprofs != blank -%}
      <li><strong>Compatible Roof Profiles: </strong>
        {%- for roof_profile in roofprofs -%}
          {{ roof_profile.name.value }}{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      </li>
    {%- endif -%}
  </ul>
</div>

<script>
  document.addEventListener('variant:change', function(event) {
    var variant = event.detail.variant;
    if (variant && variant.sku) {
      document.querySelector('.js-variant-sku').textContent = variant.sku;
    }
  });
</script>
