{%- if predictive_search.performed -%}
  <div id="rm-search-titles">
    {%- for search_product in predictive_search.resources.products -%}
      {%- assign full_product = all_products[search_product.handle] -%}
      {%- assign override_title = full_product.metafields.custom.search_category_title_override.value -%}

      <span data-product-id="{{ search_product.id }}">
        {{- override_title | default: search_product.title | escape -}}
      </span>
    {%- endfor -%}
  </div>
{%- endif -%}