<style>
  .rm-topbar {
    background: #ffffff;
    border-bottom: 1px solid rgba(0,0,0,.08);
  }

  .rm-topbar__inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 16px 24px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 32px;
  }

  .rm-topbar__brand {
    display: flex;
    align-items: center;
    min-width: 260px;
  }

  .rm-topbar__logo-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
  }

  .rm-topbar__logo-image {
    display: block;
    max-width: 320px;
    height: auto;
  }

  .rm-topbar__logo-text {
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5f6b76;
    font-weight: 600;
  }

  .rm-topbar__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    min-width: 0;
  }

  .rm-topbar__search {
    flex: 1 1 auto;
    max-width: 620px;
    width: 100%;
  }

  .rm-topbar__search-form {
    position: relative;
    width: 100%;
  }

  .rm-topbar__search-input {
    width: 100%;
    height: 54px;
    border: 2px solid #d8dde3;
    border-radius: 4px;
    background: #fff;
    padding: 0 56px 0 18px;
    font-size: 16px;
    color: #1f2933;
    outline: none;
    transition: border-color .2s ease, box-shadow .2s ease;
    -webkit-appearance: none;
  }

  .rm-topbar__search-input:focus {
    border-color: #2f67b1;
    box-shadow: 0 0 0 3px rgba(47,103,177,.12);
  }

  .rm-topbar__search-input::placeholder {
    color: #8b98a5;
  }

  .rm-topbar__search-button {
    position: absolute;
    top: 50%;
    right: 14px;
    transform: translateY(-50%);
    background: transparent;
    border: 0;
    padding: 0;
    width: 24px;
    height: 24px;
    color: #7a8793;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .rm-topbar__cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    color: #1f2933;
    text-decoration: none;
    flex: 0 0 auto;
  }

  .rm-topbar__cart svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  .rm-topbar__cart-count {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: #2f67b1;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 22px;
    text-align: center;
  }

  .rm-topbar__shop-name {
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
    color: #111;
  }

  @media screen and (max-width: 989px) {
    .rm-topbar__inner {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 14px 16px;
    }

    .rm-topbar__brand {
      justify-content: center;
    }

    .rm-topbar__right {
      justify-content: stretch;
      gap: 12px;
    }

    .rm-topbar__search {
      max-width: none;
    }

    .rm-topbar__logo-image {
      max-width: 260px;
    }

    .rm-topbar__logo-text {
      font-size: 12px;
    }

    .rm-topbar__search-input {
      height: 48px;
      font-size: 15px;
    }

    .rm-topbar__cart {
      width: 42px;
      height: 42px;
    }
  }

  @media screen and (max-width: 749px) {
    .rm-topbar__right {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .rm-topbar__brand {
      justify-content: flex-start;
    }

    .rm-topbar__logo-image {
      max-width: 220px;
    }
  }
</style>

<div class="rm-topbar">
  <div class="rm-topbar__inner">
    <div class="rm-topbar__brand">
      <a href="{{ routes.root_url }}" class="rm-topbar__logo-wrap" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 640
            | image_tag:
              class: 'rm-topbar__logo-image',
              loading: 'eager',
              widths: '180, 240, 320, 480, 640',
              alt: shop.name
          }}
        {% else %}
          <span class="rm-topbar__shop-name">{{ shop.name }}</span>
        {% endif %}
        <span class="rm-topbar__logo-text">Contractor trusted since 2017</span>
      </a>
    </div>

    <div class="rm-topbar__right">
      <div class="rm-topbar__search">
        <form action="{{ routes.search_url }}" method="get" role="search" class="rm-topbar__search-form">
          <input
            class="rm-topbar__search-input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search products, SKUs, brands..."
            aria-label="Search products"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button class="rm-topbar__search-button" type="submit" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>
          </button>
        </form>
      </div>

      <a href="{{ routes.cart_url }}" class="rm-topbar__cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="20" r="1.5"></circle>
          <circle cx="18" cy="20" r="1.5"></circle>
          <path d="M2 3h3l2.2 10.2a1 1 0 0 0 1 .8h9.8a1 1 0 0 0 1-.8L21 7H6"></path>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="rm-topbar__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</div>