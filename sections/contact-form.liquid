{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

small#ContactForm-email-error {
    position: absolute;
    bottom: -1.7rem;
}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
   
    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
    
      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            aria-required="true"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
            required
          >
          <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}<span aria-hidden="true">*</span></label>
         </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}<span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                {%- render 'icon-error' -%}
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      </div>
      <div class="field">
        <input
          type="tel"
          id="ContactForm-phone"
          class="field__input"
          autocomplete="tel"
          name="contact[{{ 'templates.contact.form.phone' | t }}]"
          pattern="[0-9\-]*"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          placeholder="{{ 'templates.contact.form.phone' | t }}"
        >
        <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
      </div>
      <div class="field">
        <label class="field__label" for="ContactForm-category">{{ 'templates.contact.form.category' | t }}<span aria-hidden="true">*</span></label>
        <select
          class="field__input"
          id="ContactForm-category"
          aria-required="true"
          name="contact[{{ 'templates.contact.form.category' | t }}]"
          required
        >
          <option value="Unselected" disabled selected>{{ 'templates.contact.form.select_option' | t }}<span aria-hidden="true">*</span></option>
          <option value="Order Inquiry">{{ 'templates.contact.form.option_order' | t }}</option>
          <option value="Quote">{{ 'templates.contact.form.option_quote' | t }}</option>
          <option value="Shipping Issue">{{ 'templates.contact.form.option_shipping' | t }}</option>
          <option value="Product Advice">{{ 'templates.contact.form.option_product' | t }}</option>
          <option value="Returns / Refunds">{{ 'templates.contact.form.option_returns' | t }}</option>
          <option value="Technical Support">{{ 'templates.contact.form.option_tech' | t }}</option>
          <option value="Feedback">{{ 'templates.contact.form.option_feedback' | t }}</option>
           <option value="Other">{{ 'templates.contact.form.option_other' | t }}</option>
        </select>
      </div>
     <div class="field" id="returns-reason-field" style="display: none;">
  <label class="field__label" for="ContactForm-returns-reason">
    {{ 'templates.contact.form.return_reason' | t }}<span aria-hidden="true">*</span>
  </label>
  <select
    class="field__input"
    id="ContactForm-returns-reason"
    aria-required="true"
    name="contact[{{ 'templates.contact.form.return_reason' | t }}]"
    required
  >
    <option value="" disabled selected hidden>{{ 'templates.contact.form.select_return' | t }}</option>
    <option value="I received the wrong item">{{ 'templates.contact.form.wrong_item' | t }}</option>
    <option value="Item(s) arrived damaged in shipping">{{ 'templates.contact.form.ship_damage' | t }}</option>
    <option value="I no longer need the item">{{ 'templates.contact.form.not_needed' | t }}</option>
    <option value="I ordered the wrong product">{{ 'templates.contact.form.ordered_wrong' | t }}</option>
    <option value="Product is incompatible">{{ 'templates.contact.form.incompatible' | t }}</option>
    <option value="Product arrived late">{{ 'templates.contact.form.late' | t }}</option>
    <option value="Product broken or defective">{{ 'templates.contact.form.defective' | t }}</option>
    <option value="Other (please explain below)">{{ 'templates.contact.form.other' | t }}</option>
  </select>
</div>

<div class="field" id="other-reason-field" style="display: none;">
  <textarea
    rows="3"
    id="ContactForm-other-reason"
    class="text-area field__input"
    name="contact[{{ 'templates.contact.form.other_reason_explain' | t }}]"
    placeholder="{{ 'templates.contact.form.other_reason_explain' | t }}"
  ></textarea>
  <label class="form__label field__label" for="ContactForm-other-reason">
    {{ 'templates.contact.form.other_reason_explain' | t }}
  </label>
</div>

      <div class="field" id="order-number-field" style="display: none;">
  <input
    class="field__input"
    type="text"
    id="ContactForm-order-number"
    name="contact[{{ 'templates.contact.form.order-number' | t }}]"
    value=""
    placeholder="{{ 'templates.contact.form.order-number' | t }}"
  >
  <label class="field__label" for="ContactForm-order-number">
    {{ 'templates.contact.form.enter-order-number' | t }}
  </label>

</div>
      <div class="field">
        <textarea
          rows="10"
          id="ContactForm-body"
          aria-required="true"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
          required
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-body">
          {{- 'templates.contact.form.comment' | t -}}<span aria-hidden="true">*</span>
        </label>
      </div>


      
<div class="field" id="returns-terms-field" style="display: none; padding:1.5rem;">
  <h3 style="margin:0;">Return Policy Acknowledgement</h3>
  <label class="checkbox__label">
    <input
      type="checkbox"
      id="returns-term-1"
      aria-required="true"
      name="contact[{{ 'templates.contact.form.returns_terms' | t }}]"
      value="{{ 'templates.contact.form.returns_terms' | t }}"
      class="checkbox"
    >
    <span>
      {{ 'templates.contact.form.returns_terms_label' | t }}
      
    </span>
  </label>

  <label class="checkbox__label">
    <input
      type="checkbox"
      id="returns-term-2"
      aria-required="true"
      name="contact[{{ 'templates.contact.form.return_terms_condition' | t }}]"
      value="{{ 'templates.contact.form.returns_terms_condition_label' | t }}"
      class="checkbox"
      req
    >
    <span>
      {{ 'templates.contact.form.returns_terms_condition_label' | t }}
    </span>
  </label>
</div>


      
      <div class="contact__button">
        <button type="submit" class="button">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
       {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        
      {%- endif -%}
    {%- endform -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('ContactForm');
    const categorySelect = document.getElementById('ContactForm-category');
    const returnsField = document.getElementById('returns-reason-field');
    const returnReasonSelect = document.getElementById('ContactForm-returns-reason');
    const orderNumberField = document.getElementById('order-number-field');
    const returnsTermsField = document.getElementById('returns-terms-field');
    const otherReasonField = document.getElementById('other-reason-field');
    const otherReasonInput = document.getElementById('ContactForm-other-reason');

    const returnTerm1 = document.getElementById('returns-term-1');
    const returnTerm2 = document.getElementById('returns-term-2');

    function toggleReturnsField() {
      const isReturns = categorySelect.value === 'Returns / Refunds';

      if (returnsField) returnsField.style.display = isReturns ? 'block' : 'none';
      if (orderNumberField) orderNumberField.style.display = isReturns ? 'block' : 'none';
      if (returnsTermsField) returnsTermsField.style.display = isReturns ? 'block' : 'none';

      if (returnReasonSelect) returnReasonSelect.required = isReturns;
      if (returnTerm1) returnTerm1.required = isReturns;
      if (returnTerm2) returnTerm2.required = isReturns;

      if (!isReturns) {
        returnTerm1?.checked && (returnTerm1.checked = false);
        returnTerm2?.checked && (returnTerm2.checked = false);
        if (otherReasonField) otherReasonField.style.display = 'none';
        if (otherReasonInput) {
          otherReasonInput.required = false;
          otherReasonInput.value = '';
        }
      }
    }

    function toggleOtherReason() {
      const isOther = returnReasonSelect?.value === 'Other (please explain below)';
      if (otherReasonField) otherReasonField.style.display = isOther ? 'block' : 'none';
      if (otherReasonInput) {
        otherReasonInput.required = isOther;
        if (!isOther) otherReasonInput.value = '';
      }
    }

    // Initialize on page load
    toggleReturnsField();
    toggleOtherReason();

    categorySelect?.addEventListener('change', function () {
      toggleReturnsField();
      toggleOtherReason();
    });

    returnReasonSelect?.addEventListener('change', toggleOtherReason);
  });
</script>




    
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Contact form",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
