<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'custom.css' | asset_url | stylesheet_tag }}

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{% liquid
  assign section_id = 'rm-topbar-' | append: section.id
%}
<style>
  div#freshworks-frame-wrapper,
  iframe#launcher-frame {
    right: 0 !important;
    left: unset !important;
  }

  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
    flex: 0 0 auto;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  #{{ section_id }} {
    --rm-border: #d7dbe1;
    --rm-text: #111827;
    --rm-muted: #6b7280;
    --rm-bg: #ffffff;
    --rm-accent: #2f67b1;
    --rm-shadow: 0 12px 30px rgba(17,24,39,.12);

    background: var(--rm-bg);
    border-bottom: 1px solid rgba(0,0,0,.08);
    position: relative;
    z-index: 20;
  }

  #{{ section_id }} .rm-topbar__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_y_topbar }}px {{ section.settings.padding_x_topbar }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2%;
  }

  #{{ section_id }} .rm-topbar__brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    min-width: 0;
    flex: 0 1 auto;
  }

  #{{ section_id }} .rm-topbar__logo-image {
    display: block;
    width: auto;
    max-width: {{ section.settings.logo_width_topbar }}px;
    max-height: 90px;
    height: auto;
  }

  #{{ section_id }} .rm-topbar__logo-fallback {
    font-size: 28px;
    line-height: 1;
    font-weight: 700;
    color: var(--rm-text);
  }

  #{{ section_id }} .rm-topbar__tagline {
    margin-top: 4px;
    font-size: clamp(10px, 1.2vw, 13px);
    line-height: 1.2;
    letter-spacing: .04em;
    text-transform: capitalize;
    color: black;
    font-weight: 500;
    font-family: Poppins, sans-serif;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  #{{ section_id }} .rm-topbar__search-wrap {
    position: relative;
    min-width: 0;
    margin-left: 20px;
    width: 100%;
    max-width: 450px;
    flex: 1 1 auto;
  }

  #{{ section_id }} input.rm-topbar__search-input::placeholder {
    color: #6a6a6a !important;
    opacity: 1 !important;
  }

  #{{ section_id }} input.rm-topbar__search-input::-webkit-input-placeholder {
    color: #6a6a6a !important;
  }

  #{{ section_id }} input.rm-topbar__search-input::-moz-placeholder {
    color: #6a6a6a !important;
  }

  #{{ section_id }} input.rm-topbar__search-input:-ms-input-placeholder {
    color: #6a6a6a !important;
  }

  #{{ section_id }} .rm-topbar__search-form {
    position: relative;
    width: 100%;
  }

  #{{ section_id }} .rm-topbar__search-input {
    width: 100%;
    height: 50px;
    border: 2px solid black;
    border-radius: 3px;
    background: #fff;
    padding: 0 54px 0 18px;
    font-size: 16px;
    line-height: 1;
    color: var(--rm-text);
    outline: none;
    box-sizing: border-box;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  #{{ section_id }} .rm-topbar__search-input:focus {
    border-color: var(--rm-accent);
    box-shadow: 0 0 0 4px rgba(47,103,177,.12);
  }

  #{{ section_id }} .rm-topbar__search-input::placeholder {
    color: #98a2b3;
  }

  #{{ section_id }} .rm-topbar__search-button {
    position: absolute;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: black;
    cursor: pointer;
    padding: 0;
  }

  #{{ section_id }} .rm-topbar__search-button svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  #{{ section_id }} .rm-topbar__cart {
    position: relative;
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--rm-accent);
    text-decoration: none;
    flex: 0 0 auto;
  }

  #{{ section_id }} .rm-topbar__icon,
  #{{ section_id }} .rm-topbar__cart,
  #{{ section_id }} .rm-topbar__account {
    transition: color .18s ease, transform .15s ease;
  }

  #{{ section_id }} .rm-topbar__icon:hover,
  #{{ section_id }} .rm-topbar__cart:hover,
  #{{ section_id }} .rm-topbar__account:hover {
    color: #000;
    transform: translateY(-1px);
  }

  #{{ section_id }} .rm-topbar__icon svg,
  #{{ section_id }} .rm-topbar__cart svg,
  #{{ section_id }} .rm-topbar__account svg {
    stroke: currentColor;
  }

  #{{ section_id }} .rm-topbar__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #{{ section_id }} .rm-topbar__icon {
    position: relative;
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--rm-accent);
    text-decoration: none;
    flex: 0 0 auto;
  }

  #{{ section_id }} .rm-topbar__icon svg {
    width: 28px;
    height: 28px;
    display: block;
    stroke: currentColor;
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ section_id }} .rm-topbar__icon .avatar {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    display: block;
  }

  #{{ section_id }} .rm-topbar__cart-count {
    position: absolute;
    top: -2px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--rm-accent);
    color: #fff;
    font-size: 11px;
    line-height: 20px;
    text-align: center;
    font-weight: 700;
  }

  #{{ section_id }} .rm-topbar__cart svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  .rm-topbar__icon_wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
  }

  #{{ section_id }} .rm-topbar__results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid rgba(17,24,39,.08);
    border-radius: 14px;
    box-shadow: var(--rm-shadow);
    overflow: hidden;
    display: none;
    z-index: 40;
  }

  #{{ section_id }} .rm-topbar__results.is-open {
    display: block;
  }

  #{{ section_id }} .rm-topbar__results-inner {
    max-height: 70vh;
    overflow: auto;
    padding: 10px 0;
  }

  #{{ section_id }} .rm-topbar__results-grid {
    display: grid;
    grid-template-columns: minmax(180px,240px) 1fr;
    gap: 24px;
    padding: 6px 14px 14px;
  }

  #{{ section_id }} .rm-topbar__results-col + .rm-topbar__results-col {
    border-left: 1px solid rgba(17,24,39,.08);
    padding-left: 24px;
  }

  #{{ section_id }} .rm-topbar__group-title {
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--rm-muted);
    font-weight: 700;
    margin: 10px 0 8px;
  }

  #{{ section_id }} .rm-topbar__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #{{ section_id }} .rm-topbar__item {
    margin: 0;
    padding: 0;
  }

  #{{ section_id }} .rm-topbar__link,
  #{{ section_id }} .rm-topbar__product {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--rm-text);
    padding: 10px 8px;
    border-radius: 10px;
    transition: background .18s ease;
  }

  #{{ section_id }} .rm-topbar__link:hover,
  #{{ section_id }} .rm-topbar__product:hover {
    background: #f7f8fa;
  }

  #{{ section_id }} .rm-topbar__thumb {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: #f4f4f5;
    flex: 0 0 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .rm-topbar__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section_id }} .rm-topbar__product-text {
    min-width: 0;
  }

  #{{ section_id }} .rm-topbar__product-title,
  #{{ section_id }} .rm-topbar__text {
    font-size: 15px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--rm-text);
  }

  #{{ section_id }} .rm-topbar__product-price {
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.2;
    color: var(--rm-muted);
  }

  #{{ section_id }} .rm-topbar__footer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    text-decoration: none;
    color: var(--rm-text);
    border-top: 1px solid rgba(17,24,39,.08);
    padding: 14px 18px;
    font-weight: 700;
  }

  #{{ section_id }} .rm-topbar__empty,
  #{{ section_id }} .rm-topbar__loading {
    padding: 16px 18px;
    font-size: 14px;
    color: var(--rm-muted);
  }

  /* Mobile tools that move into the black header row */
  .rm-header-mobile-tools {
    display: none;
    min-width: 0;
  }

  .rm-header-mobile-tools__search {
    min-width: 0;
    width: 100%;
  }

  .rm-header-mobile-tools .rm-topbar__search-wrap {
    width: 100%;
    max-width: none;
    min-width: 0;
    margin: 0;
    position: relative;
    flex: 1 1 auto;
  }

  .rm-header-mobile-tools .rm-topbar__search-form {
    width: 100%;
    position: relative;
  }

  .rm-header-mobile-tools .rm-topbar__search-input {
    width: 100%;
    height: 40px;
    min-height: 40px;
    padding: 0 40px 0 12px;
    font-size: 14px;
    line-height: 40px;
    border: 1px solid #cfcfcf;
    border-radius: 4px;
    box-sizing: border-box;
  }

  .rm-header-mobile-tools .rm-topbar__search-button {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .rm-header-mobile-tools .rm-topbar__search-button svg {
    width: 18px;
    height: 18px;
  }

  .rm-header-mobile-tools .rm-topbar__icon_wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }

  .rm-header-mobile-tools .rm-topbar__icon,
  .rm-header-mobile-tools .rm-topbar__cart {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .rm-header-mobile-tools .rm-topbar__icon svg,
  .rm-header-mobile-tools .rm-topbar__cart svg {
    width: 22px;
    height: 22px;
  }

  .rm-header-mobile-tools .rm-topbar__cart-count {
    top: 1px;
    right: 0;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    font-size: 10px;
    line-height: 16px;
  }

  /* Desktop / tablet topbar behavior */
  @media screen and (min-width: 990px) {
    #{{ section_id }} .rm-topbar__search-wrap,
    #{{ section_id }} .rm-topbar__icon_wrapper {
      display: flex;
    }

    .rm-header-mobile-tools {
      display: none !important;
    }
  }

  /* Switch layout exactly at 989px and below */
  @media screen and (max-width: 989px) {
    #{{ section_id }} .rm-topbar__search-wrap,
    #{{ section_id }} .rm-topbar__icon_wrapper {
      display: none !important;
    }

    #{{ section_id }} .rm-topbar__inner {
      padding: 14px 16px;
    }

    #{{ section_id }} .rm-topbar__logo-image {
      max-width: min({{ section.settings.logo_width_topbar }}px, 220px);
    }

    #{{ section_id }} .rm-topbar__tagline {
      font-size: 12px;
    }

    .header {
      display: flex;
      flex-direction:row;
      align-items: center;
      column-gap: 12px;
          padding: 5px 10px !important;
    }
    .rm-header-mobile-tools .rm-topbar__icon svg, .rm-header-mobile-tools .rm-topbar__cart svg{
    height:50px !important;
  width:50px !important;
color:#fff;}
  

    .rm-header-mobile-tools {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      width: 100%;
      min-width: 0;
    }

    .rm-header-mobile-tools__search,
    .rm-header-mobile-tools .rm-topbar__search-wrap,
    .rm-header-mobile-tools .rm-topbar__search-form {
      max-width: none !important;
      width: 100% !important;
      margin: 0 !important;
      min-width: 0;
    }

    .header__heading,
    .header__heading-link,
    .header__heading-logo-wrapper {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 830px) {
    #{{ section_id }} .rm-topbar__inner {
      gap: 10px !important;
      flex-wrap: wrap;
    }
  }

  @media screen and (max-width: 749px) {
    .header {
      padding-left: 16px;
      padding-right: 16px;
    }

    .rm-header-mobile-tools {
      gap: 8px;
    }

    .rm-header-mobile-tools .rm-topbar__search-input {
      height: 38px;
      min-height: 38px;
      font-size: 13px;
      padding: 0 38px 0 10px;
    }

    .rm-header-mobile-tools .rm-topbar__icon,
    .rm-header-mobile-tools .rm-topbar__cart {
      width: 34px;
      height: 34px;
    }

    .rm-header-mobile-tools .rm-topbar__icon svg,
    .rm-header-mobile-tools .rm-topbar__cart svg {
      width: 20px;
      height: 20px;
    }
  }

  @media screen and (max-width: 712px) {
    #{{ section_id }} .rm-topbar__brand {
      width: 100%;
      text-align: center;
      align-items: center;
    }
  }
</style>
{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- assign desktop_menu = section.settings.menu -%}
{%- assign mobile_menu_handle = section.settings.mobile_menu -%}
{%- assign mobile_menu = linklists[mobile_menu_handle] -%}

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }} {% if header_tag == 'sticky-header' %}data-sticky-type="{{ section.settings.sticky_header_type }}"{% endif %} class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  <section id="{{ section_id }}" class="rm-topbar" data-rm-topbar>
    <div class="rm-topbar__inner">
      <a href="{{ routes.root_url }}" class="rm-topbar__brand" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 720
            | image_tag:
              class: 'rm-topbar__logo-image',
              loading: 'eager',
              widths: '180, 240, 360, 540, 720',
              alt: shop.name
          }}
        {% else %}
          <span class="rm-topbar__logo-fallback">{{ shop.name }}</span>
        {% endif %}

        {% if section.settings.tagline != blank %}
          <span class="rm-topbar__tagline">{{ section.settings.tagline }}</span>
        {% endif %}
      </a>

      <div class="rm-topbar__search-wrap" data-search-wrap>
        <form action="{{ routes.search_url }}" method="get" role="search" class="rm-topbar__search-form" data-search-form>
          <input
            class="rm-topbar__search-input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Search products, brands, and pages"
            aria-expanded="false"
            aria-haspopup="listbox"
            data-search-input
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="rm-topbar__search-button" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>
          </button>
        </form>

        <div class="rm-topbar__results" data-search-results>
          <div class="rm-topbar__results-inner" data-search-results-inner></div>
        </div>
      </div>

      <div class="rm-topbar__icon_wrapper">
        <a href="{{ routes.cart_url }}" class="rm-topbar__cart" aria-label="Cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="20" r="1.5"></circle>
            <circle cx="18" cy="20" r="1.5"></circle>
            <path d="M2 3h3l2.2 10.2a1 1 0 0 0 1 .8h9.8a1 1 0 0 0 1-.8L21 7H6"></path>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="rm-topbar__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="rm-topbar__icon rm-topbar__account"
            rel="nofollow"
            aria-label="{%- if customer -%}Account{%- else -%}Log in{%- endif -%}"
          >
            {%- if section.settings.enable_customer_avatar and customer and customer.has_avatar? -%}
              {{ customer | avatar }}
            {%- else -%}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M4 20.5c1.7-4.2 14.3-4.2 16 0"></path>
              </svg>
            {%- endif -%}

            <span class="visually-hidden">
              {%- liquid
                if customer
                  echo 'customer.account_fallback' | t
                else
                  echo 'customer.log_in' | t
                endif
              -%}
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}

