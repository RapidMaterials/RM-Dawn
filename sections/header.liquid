<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'custom.css' | asset_url | stylesheet_tag }}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  div#freshworks-frame-wrapper,
  iframe#launcher-frame {
    right: 0 !important;
    left: unset !important;
  }

  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    width: 100%;
    gap: 1.2rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  summary.list-menu__item {
    padding-right: 2rem;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  .header-wrapper {
    background: {{ section.settings.nav_bg }};
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .section-header {
    position: sticky;
    top: 0;
    z-index: 30;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  .header.header--nav-only {
    min-height: 68px;
    padding: 0 {{ section.settings.side_padding }}px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 2rem;
  }

  .header.header--nav-only .header__inline-menu {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .header.header--nav-only .header__inline-menu .list-menu--inline > li {
    flex: 1 1 0;
    display: flex;
    justify-content: center;
  }

  .header.header--nav-only .header__inline-menu .list-menu--inline > li > a,
  .header.header--nav-only .header__inline-menu .list-menu--inline > li > header-menu,
  .header.header--nav-only .header__inline-menu .list-menu--inline > li > details {
    width: 100%;
  }

  .header.header--nav-only .header__inline-menu .list-menu__item,
  .header.header--nav-only .header__inline-menu .list-menu__item--link {
    justify-content: center;
    text-align: center;
    font-size: 1.15rem;
    font-weight: 600;
    color: {{ section.settings.link_color }};
    letter-spacing: 0.01em;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .header.header--nav-only .header__inline-menu .list-menu__item--link:hover,
  .header.header--nav-only .header__inline-menu summary.list-menu__item:hover,
  .header.header--nav-only .header__inline-menu .header__menu-item:hover {
    color: {{ section.settings.link_hover_color }};
  }

  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child {
    flex: 0 0 auto;
  }

  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child > a,
  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child > header-menu > details > summary,
  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child > details > summary {
    background: {{ section.settings.cta_bg }};
    color: {{ section.settings.cta_text }};
    border-radius: {{ section.settings.cta_radius }}px;
    padding: 1.1rem 1.8rem;
    min-height: auto;
  }

  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child > a:hover,
  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child > header-menu > details > summary:hover,
  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child > details > summary:hover {
    background: {{ section.settings.cta_bg_hover }};
    color: {{ section.settings.cta_text }};
  }

  .header.header--nav-only .header__inline-menu .list-menu--inline > li:last-child .icon-caret {
    color: {{ section.settings.cta_text }};
  }

  .header.header--nav-only .header__inline-menu .icon-caret {
    right: 1rem;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (max-width: 1199px) {
    .header.header--nav-only {
      padding: 0 2rem;
    }

    .header.header--nav-only .header__inline-menu .list-menu__item,
    .header.header--nav-only .header__inline-menu .list-menu__item--link {
      font-size: 1.05rem;
    }

    .list-menu--inline {
      gap: 0.75rem;
    }
  }

  @media screen and (max-width: 989px) {
    .header.header--nav-only {
      min-height: 56px;
      padding: 0 1.6rem;
      grid-template-columns: auto 1fr;
    }

    .header.header--nav-only .header__inline-menu {
      display: none;
    }
  }
</style>

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- assign desktop_menu = section.settings.menu -%}
{%- assign mobile_menu_handle = section.settings.mobile_menu | default: 'main-menu' -%}
{%- assign mobile_menu = linklists[mobile_menu_handle] -%}

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }} {% if header_tag == 'sticky-header' %}data-sticky-type="{{ section.settings.sticky_header_type }}"{% endif %} class="header-wrapper">
  <header class="header header--nav-only page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}">
    {%- liquid
      if section.settings.menu != blank
        render 'header-drawer', menu: mobile_menu
      endif
    -%}

    <div class="header__inline-menu">
      {%- liquid
        if section.settings.menu != blank
          if section.settings.menu_type_desktop == 'dropdown'
            render 'header-dropdown-menu'
          elsif section.settings.menu_type_desktop != 'drawer'
            render 'header-mega-menu'
          endif
        endif
      -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Desktop menu"
    },
    {
      "type": "text",
      "id": "mobile_menu",
      "default": "main-menu",
      "label": "Mobile menu handle"
    },
    {
      "type": "select",
      "id": "menu_type_desktop",
      "options": [
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "mega",
          "label": "Mega menu"
        },
        {
          "value": "drawer",
          "label": "Drawer"
        }
      ],
      "default": "dropdown",
      "label": "Desktop menu type"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "on-scroll-up",
          "label": "Show on scroll up"
        },
        {
          "value": "always",
          "label": "Always"
        }
      ],
      "default": "on-scroll-up",
      "label": "Sticky header"
    },
    {
      "type": "color",
      "id": "nav_bg",
      "label": "Nav background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#8fb6ea"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Last item background",
      "default": "#2f67b1"
    },
    {
      "type": "color",
      "id": "cta_bg_hover",
      "label": "Last item hover background",
      "default": "#1f4f90"
    },
    {
      "type": "color",
      "id": "cta_text",
      "label": "Last item text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Last item corner radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Side padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}