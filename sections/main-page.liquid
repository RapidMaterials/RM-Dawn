{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .main-page-grid-{{ section.id }} {
    display: grid;
    gap: 2rem;
  }

  @media screen and (min-width: 990px) {
    .main-page-grid-{{ section.id }} {
      /* Default fallback */
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    /* Column split options (apply only on desktop) */
    .main-page-grid-{{ section.id }}.split-50-50 { grid-template-columns: 50% 50%; }
    .main-page-grid-{{ section.id }}.split-60-40 { grid-template-columns: 60% 40%; }
    .main-page-grid-{{ section.id }}.split-70-30 { grid-template-columns: 70% 30%; }
    .main-page-grid-{{ section.id }}.split-80-20 { grid-template-columns: 80% 20%; }
    .main-page-grid-{{ section.id }}.split-40-60 { grid-template-columns: 40% 60%; }
    .main-page-grid-{{ section.id }}.split-30-70 { grid-template-columns: 30% 70%; }
    .main-page-grid-{{ section.id }}.split-20-80 { grid-template-columns: 20% 80%; }
  }

  /* Right column inner padding so color scheme background has breathing room */
  .main-page-right-inner-{{ section.id }} {
    padding: 20px;
    border-radius: 8px;
  }

  .main-page-right-inner-{{ section.id }} .rte p:first-child {
    margin-top: 0;
  }

  .main-page-right-block-{{ section.id }} + .main-page-right-block-{{ section.id }} {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(0,0,0,0.12);
  }

  /* If your color schemes are dark, the border might be too dark/light.
     This keeps it subtle in most schemes. */
  .color-{{ section.settings.right_color_scheme }} .main-page-right-block-{{ section.id }} + .main-page-right-block-{{ section.id }} {
    border-top-color: rgba(255,255,255,0.18);
  }
{%- endstyle -%}

{%- assign container_class = '' -%}
{%- case section.settings.content_width -%}
  {%- when 'narrow' -%}
    {%- assign container_class = 'page-width page-width--narrow' -%}
  {%- when 'normal' -%}
    {%- assign container_class = 'page-width' -%}
  {%- when 'full' -%}
    {%- assign container_class = '' -%}
{%- endcase -%}

{%- assign title_tag = section.settings.title_tag | default: 'h1' -%}
{%- assign split_class = section.settings.column_split | default: 'split-50-50' -%}

<div class="{% unless container_class == blank %}{{ container_class }}{% endunless %} section-{{ section.id }}-padding">

  {%- if section.settings.layout == 'two_column' -%}
    <div class="main-page-grid-{{ section.id }} {{ split_class }}">

      <!-- Column 1 -->
      <div>
        {%- if section.settings.show_title -%}
          <{{ title_tag }}
            class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
            {{ page.title | escape }}
          </{{ title_tag }}>
        {%- endif -%}

        <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ page.content }}
        </div>
      </div>

      <!-- Column 2 (wrapped in color scheme) -->
      <div class="color-{{ section.settings.right_color_scheme }} gradient">
        <div class="main-page-right-inner-{{ section.id }}">
          {%- assign has_right_blocks = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'right_item' -%}
              {%- if block.settings.enabled -%}
                {%- assign has_right_blocks = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_right_blocks -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'right_item' and block.settings.enabled -%}
                {%- assign block_heading = block.settings.heading | strip -%}
                {%- assign block_tag = block.settings.heading_tag | default: 'h3' -%}

                <div class="main-page-right-block-{{ section.id }}" {{ block.shopify_attributes }}>
                  {%- if block_heading != blank -%}
                    <{{ block_tag }}
                      class="h3{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
                      {{ block_heading | escape }}
                    </{{ block_tag }}>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

    </div>

  {%- else -%}

    {%- if section.settings.show_title -%}
      <{{ title_tag }}
        class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ page.title | escape }}
      </{{ title_tag }}>
    {%- endif -%}

    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>

  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "narrow",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "Normal" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "full_width",
      "options": [
        { "value": "full_width", "label": "Full width (1 column)" },
        { "value": "two_column", "label": "Two column" }
      ]
    },
    {
      "type": "select",
      "id": "column_split",
      "label": "Two column split (desktop)",
      "default": "split-50-50",
      "options": [
        { "value": "split-50-50", "label": "50 / 50" },
        { "value": "split-60-40", "label": "60 / 40" },
        { "value": "split-70-30", "label": "70 / 30" },
        { "value": "split-80-20", "label": "80 / 20" },
        { "value": "split-40-60", "label": "40 / 60" },
        { "value": "split-30-70", "label": "30 / 70" },
        { "value": "split-20-80", "label": "20 / 80" }
      ]
    },

    {
      "type": "header",
      "content": "Page title"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Page title heading tag",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ]
    },

    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "color_scheme",
      "id": "right_color_scheme",
      "label": "Right column color scheme",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "right_item",
      "name": "Right column item",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Enable this block",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Right column heading"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "default": "h3",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ]
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add helpful details here.</p>"
        }
      ]
    }
  ]
}
{% endschema %}