{%- comment -%}
  Section: Collection Features Icons (Metafield Driven)

  Pulls from: collection.metafields.custom.features (list of metaobjects)
  Expected fields on each metaobject:
    - icon (file/image)
    - headline (text)
    - sub_headline (text)
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-features-{{ section.id }} {
    {% if section.settings.use_background %}
      background: {{ section.settings.background_color }};
    {% endif %}
  }

  .collection-features-{{ section.id }} .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ section.settings.min_col_width }}px, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }

  .collection-features-{{ section.id }} .feature {
    text-align: center;
  }

  .collection-features-{{ section.id }} .feature__image {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .collection-features-{{ section.id }} .feature__title {
    margin: 0;
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .collection-features-{{ section.id }} .feature__subtitle {
    margin: 0.25rem 0 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }
{%- endstyle -%}

{%- assign features = collection.metafields.custom.features.value -%}

{%- if collection != blank and features != blank -%}
  <div class="collection-features-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="title title--primary" style="margin-top:0;">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <ul class="features-list">
        {%- for f in features -%}
          <li class="feature">
            {%- if f.icon.value != blank -%}
              <img
                src="{{ f.icon.value | image_url: width: 128 }}"
                alt="{{ f.headline.value | escape }}"
                class="feature__image"
                loading="lazy"
              >
            {%- endif -%}

            {%- if f.headline.value != blank -%}
              <h3 class="feature__title">{{ f.headline.value }}</h3>
            {%- endif -%}

            {%- if f.sub_headline.value != blank -%}
              <p class="feature__subtitle">{{ f.sub_headline.value }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection Icon List",
  "tag": "section",
  "class": "section",
  "templates": ["collection"],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (optional)",
      "default": "Key Features"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_background",
      "label": "Enable background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#d9d9d9"
    },
    {
      "type": "range",
      "id": "min_col_width",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Min column width",
      "default": 160
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Collection Icon List"
    }
  ]
}
{% endschema %}
