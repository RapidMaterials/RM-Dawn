{%- style -%}
  .rm-hero-{{ section.id }} {
    position: relative;
  }

  .rm-hero-{{ section.id }} .rm-hero__slider {
    position: relative;
    overflow: hidden;
  }

  .rm-hero-{{ section.id }} .rm-hero__track {
    display: flex;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .rm-hero-{{ section.id }} .rm-hero__slide {
    min-width: 100%;
    position: relative;
    overflow: hidden;
  }

  .rm-hero-{{ section.id }} .rm-hero__media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .rm-hero-{{ section.id }} .rm-hero__image,
  .rm-hero-{{ section.id }} .rm-hero__image-mobile {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rm-hero-{{ section.id }} .rm-hero__image-mobile {
    display: none;
  }

  .rm-hero-{{ section.id }} .rm-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .rm-hero-{{ section.id }} .rm-hero__inner {
    position: relative;
    z-index: 3;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    min-height: {{ section.settings.desktop_height }}px;
    padding: {{ section.settings.padding_top }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom }}px;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: {{ section.settings.horizontal_alignment }};
    text-align: {{ section.settings.text_alignment }};
  }

  .rm-hero-{{ section.id }} .rm-hero__content {
    width: 100%;
    max-width: {{ section.settings.text_max_width }}px;
  }

  .rm-hero-{{ section.id }} .rm-hero__logo-wrap {
    margin-bottom: 18px;
  }

  .rm-hero-{{ section.id }} .rm-hero__logo {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: {{ section.settings.logo_max_height }}px;
    display: inline-block;
  }

  .rm-hero-{{ section.id }} .rm-hero__heading {
    margin: 0 0 18px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    line-height: 1.05;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: -0.02em;
  }

  .rm-hero-{{ section.id }} .rm-hero__text {
    margin: 0 0 28px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.45;
    font-weight: {{ section.settings.text_weight }};
  }

  .rm-hero-{{ section.id }} .rm-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 32px;
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    text-decoration: none;
    font-size: {{ section.settings.button_text_size }}px;
    font-weight: {{ section.settings.button_weight }};
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .rm-hero-{{ section.id }} .rm-hero__button:hover {
    background: {{ section.settings.button_bg_hover }};
    color: {{ section.settings.button_text }};
    transform: translateY(-1px);
  }

  .rm-hero-{{ section.id }} .rm-hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(255,255,255,0.18);
    color: #fff;
    cursor: pointer;
    display: {% if section.settings.show_arrows %}flex{% else %}none{% endif %};
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }

  .rm-hero-{{ section.id }} .rm-hero__nav--prev {
    left: 18px;
  }

  .rm-hero-{{ section.id }} .rm-hero__nav--next {
    right: 18px;
  }

  .rm-hero-{{ section.id }} .rm-hero__nav svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .rm-hero-{{ section.id }} .rm-hero__dots {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    z-index: 4;
    display: {% if section.settings.show_dots %}flex{% else %}none{% endif %};
    align-items: center;
    gap: 10px;
  }

  .rm-hero-{{ section.id }} .rm-hero__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 0;
    background: rgba(255,255,255,0.45);
    cursor: pointer;
    padding: 0;
  }

  .rm-hero-{{ section.id }} .rm-hero__dot.is-active {
    background: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .rm-hero-{{ section.id }} .rm-hero__image {
      display: none;
    }

    .rm-hero-{{ section.id }} .rm-hero__image-mobile {
      display: block;
    }

    .rm-hero-{{ section.id }} .rm-hero__inner {
      min-height: {{ section.settings.mobile_height }}px;
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.side_padding_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
      align-items: {{ section.settings.vertical_alignment_mobile }};
      justify-content: {{ section.settings.horizontal_alignment_mobile }};
      text-align: {{ section.settings.text_alignment_mobile }};
    }

    .rm-hero-{{ section.id }} .rm-hero__content {
      max-width: 100%;
    }

    .rm-hero-{{ section.id }} .rm-hero__logo-wrap {
      margin-bottom: 14px;
    }

    .rm-hero-{{ section.id }} .rm-hero__logo {
      max-height: {{ section.settings.logo_max_height_mobile }}px;
    }

    .rm-hero-{{ section.id }} .rm-hero__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      margin-bottom: 14px;
    }

    .rm-hero-{{ section.id }} .rm-hero__text {
      font-size: {{ section.settings.text_size_mobile }}px;
      margin-bottom: 22px;
    }

    .rm-hero-{{ section.id }} .rm-hero__button {
      min-height: 48px;
      padding: 0 24px;
    }

    .rm-hero-{{ section.id }} .rm-hero__nav {
      width: 38px;
      height: 38px;
    }

    .rm-hero-{{ section.id }} .rm-hero__nav--prev {
      left: 10px;
    }

    .rm-hero-{{ section.id }} .rm-hero__nav--next {
      right: 10px;
    }

    .rm-hero-{{ section.id }} .rm-hero__dots {
      bottom: 12px;
    }
  }
{%- endstyle -%}

<section class="rm-hero-{{ section.id }}" data-rm-hero-slider>
  <div class="rm-hero__slider">
    <div class="rm-hero__track" data-slider-track>
      {%- for block in section.blocks -%}
        <div class="rm-hero__slide" {{ block.shopify_attributes }}>
          <div class="rm-hero__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  class: 'rm-hero__image',
                  loading: 'lazy',
                  widths: '900, 1200, 1600, 2000, 2400',
                  alt: block.settings.heading
              }}
            {%- endif -%}

            {%- if block.settings.image_mobile != blank -%}
              {{
                block.settings.image_mobile
                | image_url: width: 1200
                | image_tag:
                  class: 'rm-hero__image-mobile',
                  loading: 'lazy',
                  widths: '480, 720, 900, 1200',
                  alt: block.settings.heading
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'rm-hero__image-mobile',
                  loading: 'lazy',
                  widths: '480, 720, 900, 1200',
                  alt: block.settings.heading
              }}
            {%- endif -%}
          </div>

          <div class="rm-hero__overlay"></div>

          <div class="rm-hero__inner">
            <div class="rm-hero__content">
              {%- if block.settings.logo != blank -%}
                <div class="rm-hero__logo-wrap">
                  {{
                    block.settings.logo
                    | image_url: width: 1200
                    | image_tag:
                      class: 'rm-hero__logo',
                      loading: 'lazy',
                      widths: '240, 400, 600, 800, 1200',
                      alt: block.settings.heading
                  }}
                </div>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h2 class="rm-hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="rm-hero__text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a class="rm-hero__button" href="{{ block.settings.button_link }}">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button class="rm-hero__nav rm-hero__nav--prev" type="button" aria-label="Previous slide" data-slider-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      <button class="rm-hero__nav rm-hero__nav--next" type="button" aria-label="Next slide" data-slider-next>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>

      <div class="rm-hero__dots" data-slider-dots>
        {%- for block in section.blocks -%}
          <button
            class="rm-hero__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            aria-label="Go to slide {{ forloop.index }}"
            data-slide-dot
            data-slide-index="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    const section = document.querySelector('.rm-hero-{{ section.id }}[data-rm-hero-slider]');
    if (!section) return;

    const track = section.querySelector('[data-slider-track]');
    const slides = section.querySelectorAll('.rm-hero__slide');
    const prevBtn = section.querySelector('[data-slider-prev]');
    const nextBtn = section.querySelector('[data-slider-next]');
    const dots = section.querySelectorAll('[data-slide-dot]');

    if (!track || slides.length <= 1) return;

    let current = 0;
    const total = slides.length;
    const autoplay = {{ section.settings.autoplay }};
    const autoplaySpeed = {{ section.settings.autoplay_speed | times: 1000 }};
    let timer = null;

    function updateSlider() {
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === current);
      });
    }

    function nextSlide() {
      current = (current + 1) % total;
      updateSlider();
    }

    function prevSlide() {
      current = (current - 1 + total) % total;
      updateSlider();
    }

    function startAutoplay() {
      if (!autoplay) return;
      stopAutoplay();
      timer = setInterval(nextSlide, autoplaySpeed);
    }

    function stopAutoplay() {
      if (timer) clearInterval(timer);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        nextSlide();
        startAutoplay();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        prevSlide();
        startAutoplay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', function() {
        current = Number(this.dataset.slideIndex);
        updateSlider();
        startAutoplay();
      });
    });

    section.addEventListener('mouseenter', stopAutoplay);
    section.addEventListener('mouseleave', startAutoplay);

    updateSlider();
    startAutoplay();
  })();
</script>

