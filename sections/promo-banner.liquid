{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: 0;
  }

  .promo-banner img {
    width: 100%;
    display: block;
  }
{%- endstyle -%}

<div class="promo-banner-section section-{{ section.id }}-padding">
  <a href="{{ section.settings.link }}" class="promo-banner">
    <picture>
      {% if section.settings.mobile_image %}
        <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url }}">
      {% endif %}
      {% if section.settings.desktop_image %}
        <img src="{{ section.settings.desktop_image | image_url }}" alt="Promo Banner" loading="lazy">
      {% endif %}
    </picture>
  </a>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}
