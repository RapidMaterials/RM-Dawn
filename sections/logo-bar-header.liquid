{% style %}
.logo-bar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  padding: 10px 20px;
}

.logo-bar-header__logo img {
  max-height: 60px;
  width: auto;
  display: block;
}

.logo-bar-header__menu ul {
  display: flex;
  gap: 20px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.logo-bar-header__menu a {
  text-decoration: none;
  font-size: 0.9em;
  text-transform: uppercase;
  color: inherit;
}
{% endstyle %}

<div class="logo-bar-header">
  <div class="logo-bar-header__logo">
    {% if section.settings.logo != blank %}
      <a href="{{ shop.url }}">
        <img
          src="{{ section.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name }}"
          loading="lazy"
        >
      </a>
    {% endif %}
  </div>

  <div class="logo-bar-header__menu">
    {% if section.settings.menu != blank %}
      <ul class="list-menu list-menu--inline" role="list">
        {% for link in linklists[section.settings.menu].links %}
          <li>
            <a
              id="HeaderMenu-{{ link.handle }}"
              class="header__menu-item list-menu__item link link--text focus-inset"
              href="{{ link.url }}"
            >
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Logo Bar Header",
  "tag": "section",
  "class": "section-logo-bar-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ],
  "presets": [
    {
      "name": "Logo Bar Header"
    }
  ]
}
{% endschema %}
