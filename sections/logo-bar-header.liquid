{% style %}
.logo-bar-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 20px;
}

.logo-bar-header img {
  max-height: 60px;
  width: auto;
  display: block;
}
{% endstyle %}

<div class="logo-bar-header">
  {% if section.settings.logo != blank %}
    <a href="{{ shop.url }}">
      <img
        src="{{ section.settings.logo | image_url: width: 800 }}"
        alt="{{ shop.name }}"
        loading="lazy"
      >
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Logo Bar Header",
  "tag": "section",
  "class": "section-logo-bar-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    }
  ],
  "presets": [
    {
      "name": "Logo Bar Header"
    }
  ]
}
{% endschema %}
