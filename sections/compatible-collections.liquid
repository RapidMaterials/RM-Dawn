{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-add-bulk.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer></script>
<script src="{{ 'price-per-item.js' | asset_url }}" defer></script>
<script src="{{ 'quick-order-list.js' | asset_url }}" defer></script>

{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

ul.list-grid {
  max-width: 1000px;
  margin: auto;
  padding: 0;
  list-style: none;
}

.list-grid li.list__item {
  display: flex;
  flex-direction: column;
  border-bottom: 1px solid #a5a5a5;
  padding: 10px 0;
}

.list-grid .card {
  display: flex;
  flex-direction: row;
}

.list-grid .card__inner.ratio {
  width: 120px;
}

.list-grid .card__content {
  width: calc(100% - 120px);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-grid .card__media {
  margin: 5px;
  width: calc(100% - 10px);
}

quick-add-bulk, .card--card.card--media>.card__content {
  margin: 0;
}
.choose-options button {
    width: 100%;
    text-transform: uppercase;
    background-color: #efefef;
    border: 1px solid white;
}
.choose-options .quick-add.no-js-hidden {
    margin: 0;
}
.quick-add-modal__content-info--bulk-details > .price {
    display: none;
}

.card__information, .card-information {
    width: 100%;
    text-align: left;
}
.page-width .collection + .collection h2.title.title--primary {
  margin-top: 3em;
}

h2.title.title--primary{
    max-width: 1200px;
    margin: auto;
    text-align: center;
    font-size: 1.5em;
    padding: 10px;
    background-color: #414141;
    color: white;
}

.card__information .card__heading,.card__information .price {
    font-size: .95em;
}

.active quick-add-bulk::after {
  content: 'ADD TO CART';
  font-size: 0.75em;
  font-style: italic;
  color: gray;
  display: block;
}
.sold-out button {
    width: 130px;
    border: 1px solid white;
    text-transform: uppercase;
}

/**modal formatting**/
.quick-add-modal__content-info--bulk-details h3 {
    font-size: 1.3em;
}
.quick-add-modal__content-info--bulk-details > .price {
    display: none;
}
.variant-item td {
    padding: 10px !important;
}
.variant-item__image-container--no-img {
    background-color: transparent;
}
.variant-item__inner .h4, .variant-item__inner .price {font-size: .9em;}

tbody tr:nth-child(even of .variant-item) > td {
  background-color: #f5f5f5;
}

.compatible-jump-nav {
  padding:15px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  background-color:#f3f3f3;
}

.compatible-jump-button {
  padding: 8px 14px;
  background-color: #414141;
  border: 1px solid #ccc;
  text-decoration: none;
  color: #fff;
  font-size: 0.85em;
  text-transform: uppercase;
  white-space: nowrap;
}

.compatible-jump-button:hover {
  background-color: #414141;
  color: #fff;
}

/* Prevent sticky header overlap */
.collection {
  scroll-margin-top: 140px; /* adjust if header height changes */
}



@media screen and (max-width: 989px) {
  .quick-add__info, td.variant-item__inner {
    display: none !important;
    width: 0 !important;
  }

  .section-bulk-quick-order-list-padding {
    padding: 10px !important;
  }

  .quick-add-modal__content-info--bulk-details {
    padding-left: 0 !important;
  }

  .quick-order-list__table thead tr {
    margin: 0 !important;
  }

  th.caption-with-letter-spacing {
    padding-bottom: 10px;
  }

  .variant-item {
    gap: .5rem !important;
    margin-bottom: 10px !important;
    display: inline !important;
  }
}


{% endstyle %}

{% assign compatible_collections = collection.metafields.custom.compatible_collections.value %}

  {% if compatible_collections != blank %}

        <div class="compatible-jump-nav">
        {% for related_collection in compatible_collections %}
            <a
            href="#collection-{{ related_collection.handle }}"
            class="compatible-jump-button"
            >
           {% assign short_title = related_collection.metafields.custom.collection_short_title | metafield_text %}

              {% if short_title != blank %}
                {{ short_title }}
              {% else %}
                {{ related_collection.title }}
              {% endif %}

            ↓ </a>
        {% endfor %}
        </div>
 {% endif %}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    {% if compatible_collections != blank %}


      {% for related_collection in compatible_collections %}
  <div
    class="collection"
    id="collection-{{ related_collection.handle }}"
  >

    <h2 class="title title--primary">
              {% assign short_title = related_collection.metafields.custom.collection_short_title | metafield_text %}

              {% if short_title != blank %}
                {{ short_title }} 
              {% else %}
                {{ related_collection.title }}
              {% endif %}

    </h2>

    <ul class="product-grid list-grid collection-quick-add-bulk">

      {% for product in related_collection.products %}
        {%- capture sort_key -%}
          {%- if product.metafields.custom.short_quick_order_title != blank -%}
            {{ product.metafields.custom.short_quick_order_title.value }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        {%- endcapture -%}

        <li
          class="list__item"
          data-sort-title="{{ sort_key | strip | downcase | escape }}"
        >
          {% render 'card-product',
            card_product: product,
            quick_add: section.settings.quick_add,
            section_id: section.id
          %}
        </li>

      {% endfor %}

    </ul>
  </div>
{% endfor %}


    {% else %}
      <p>No compatible collections assigned.</p>
    {% endif %}

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.collection ul.product-grid').forEach(function (grid) {
    const items = Array.from(grid.querySelectorAll('.list__item'));

    items
      .sort((a, b) => {
        const aKey = a.dataset.sortTitle || '';
        const bKey = b.dataset.sortTitle || '';
        return aKey.localeCompare(bKey);
      })
      .forEach(item => grid.appendChild(item));
  });
});
</script>

{% schema %}
{
  "name": "Compatible Collections",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "default": "bulk",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk (Qty + Modal)" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
