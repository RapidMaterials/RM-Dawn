{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-add-bulk.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer></script>
<script src="{{ 'price-per-item.js' | asset_url }}" defer></script>
<script src="{{ 'quick-order-list.js' | asset_url }}" defer></script>

{% style %}
 .section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
ul.list-grid {
    max-width: 1200px;
    margin: auto;
}

.list-grid li.list__item {
    display: flex;
    flex-direction: row;
}
.list-grid form.quick-add-form {
    width: 320px;
    display: flex;
    align-items:center;
    margin-bottom:30px;
}
.list-grid .card-wrapper {
    width: calc(100% - 320px);
}
.list-grid .card{
    display: flex;
    flex-direction: row;
}

.list-grid .card__inner.ratio {
    width: 140px;
}
.list-grid .card__heading, .list-grid .card-information .price {
    font-size: 1.1em;
    text-align: left;
}
.list-grid  .card__content{
  align-items:center;
}
.list-grid > .list__item > span.badge {
    border: 0;
    align-items: center;
    display: flex;
    font-size: 1em;
    max-height:30px;
    padding-top: 30px;
}
.card__badge > span{
    font-size: .8em;
    justify-content: center;
    margin: 0 auto;
}
.card__media {
    margin: .5em;
    width: calc(100% - 2 * .5em);
}

.list-grid .card--media .card__inner .card__content{
  padding:20px;
  font-size: .75em;
}
quick-add-bulk.quick-add-bulk:after {
    content: 'ADD TO CART';
    font-size: .75em;
    font-style: italic;
    color: gray;
}

/* Mobile */
@media (max-width: 749px) {
  
}

{% endstyle %}

{% assign compatible_collections = collection.metafields.custom.compatible_collections.value %}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    {% if compatible_collections != blank %}
      <ul
        id=""
        class="product-grid list-grid collection-quick-add-bulk"
        data-id="{{ section.id }}"
      >
        {% assign rendered_ids = '' %}

        {% for related_collection in compatible_collections %}
         <h3 class="title title--primary">{{ related_collection.title }}</h3>
          {% for product in related_collection.products %}
            {% unless rendered_ids contains product.id %}
              {% assign rendered_ids = rendered_ids | append: product.id | append: ',' %}

              <li class="list__item">
                {% render 'card-product',
                  card_product: product,
                  quick_add: section.settings.quick_add,
                  section_id: section.id
                %}
              </li>

            {% endunless %}
          {% endfor %}
        {% endfor %}
      </ul>
    {% else %}
      <p>No compatible collections assigned.</p>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Compatible Collections",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "default": "bulk",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk (Qty + Modal)" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
