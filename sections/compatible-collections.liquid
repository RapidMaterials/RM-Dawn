{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-add.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>

{% assign compatible_collections = collection.metafields.custom.compatible_collections.value %}

<div class="section-{{ section.id }}-padding page-width">
  {% if compatible_collections != blank %}

    <ul id="product-grid" class="product-grid">
      {% assign rendered_product_ids = '' %}

      {% for related_collection in compatible_collections %}
        {% for product in related_collection.products %}

          {%- unless rendered_product_ids contains product.id -%}
            {% assign rendered_product_ids = rendered_product_ids | append: product.id | append: ',' %}

            <li class="list__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: false,
                quick_add: 'standard',
                section_id: section.id
              %}
            </li>

          {%- endunless -%}

        {% endfor %}
      {% endfor %}
    </ul>

  {% else %}
    <p>No compatible products found.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Compatible Quick Add",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show secondary image"
    }
  ]
}
{% endschema %}
