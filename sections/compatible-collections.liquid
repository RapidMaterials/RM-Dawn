{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-add-bulk.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer></script>
<script src="{{ 'price-per-item.js' | asset_url }}" defer></script>
<script src="{{ 'quick-order-list.js' | asset_url }}" defer></script>

{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

ul.list-grid {
  max-width: 1200px;
  margin: auto;
}

.list-grid li.list__item {
  display: flex;
  flex-direction: column;
  border-bottom: 1px solid #a5a5a5;
  padding: 10px 0;
}

.list-grid .card {
  display: flex;
  flex-direction: row;
}

.list-grid .card__inner.ratio {
  width: 120px;
}

.list-grid .card__content {
  width: calc(100% - 120px);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

quick-add-bulk {
  margin: 0;
}

.active quick-add-bulk::after {
  content: 'ADD TO CART';
  font-size: 0.75em;
  font-style: italic;
  color: gray;
}
{% endstyle %}

{% assign compatible_collections = collection.metafields.custom.compatible_collections.value %}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    {% if compatible_collections != blank %}

      {% for related_collection in compatible_collections %}
        <div class="collection">

          <h3 class="title title--primary">
            {{ related_collection.title }}
          </h3>

          {% assign sorted_products = related_collection.products | sort_natural: 'title' %}
          {% assign rendered_ids = ',' %}

          <ul class="product-grid list-grid collection-quick-add-bulk">

            {% for product in sorted_products %}
              {% assign id_token = ',' | append: product.id | append: ',' %}

              {% unless rendered_ids contains id_token %}
                {% assign rendered_ids = rendered_ids | append: product.id | append: ',' %}

                <li class="list__item">
                  {% render 'card-product',
                    card_product: product,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </li>

              {% endunless %}
            {% endfor %}

          </ul>
        </div>
      {% endfor %}

    {% else %}
      <p>No compatible collections assigned.</p>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Compatible Collections",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "default": "bulk",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk (Qty + Modal)" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
