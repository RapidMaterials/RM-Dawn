{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-add-bulk.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer></script>
<script src="{{ 'price-per-item.js' | asset_url }}" defer></script>
<script src="{{ 'quick-order-list.js' | asset_url }}" defer></script>

{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

/* List layout */
.product-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0;
  margin: 0;
  list-style: none;
}

.product-grid .list__item {
  display: flex;
  padding: 14px 16px;
  border-bottom: 1px solid #e1e1e1;
}

.card {
  display: flex;
  flex-direction: row;
  width: 100%;
}

.card__inner.ratio {
  width: 120px;
}

.card__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(100% - 120px);
}

quick-add-bulk {
  margin-left: 12px;
}

quick-add-bulk::after {
  content: 'ADD TO CART';
  font-size: 0.75em;
  font-style: italic;
  color: gray;
}
{% endstyle %}

{% assign compatible_collections = collection.metafields.custom.compatible_collections.value %}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    {% if compatible_collections != blank %}

      <!-- SORT -->
      <div style="margin-bottom:16px;">
        <label for="CompatibleSort" class="visually-hidden">Sort products</label>
        <select id="CompatibleSort" class="select__select">
          <option value="asc" selected>Alphabetical, A–Z</option>
          <option value="desc">Alphabetical, Z–A</option>
        </select>
      </div>

      <!-- PRODUCT LIST -->
      <ul
        id="product-grid"
        class="product-grid collection-quick-add-bulk"
        data-id="{{ section.id }}"
      >
        {% assign rendered_ids = '' %}

        {% for related_collection in compatible_collections %}
          {% for product in related_collection.products %}
            {% unless rendered_ids contains product.id %}
              {% assign rendered_ids = rendered_ids | append: product.id | append: ',' %}

              <li
                class="list__item"
                data-title="{{ product.title | downcase }}"
              >
                <div class="card-wrapper product-card-wrapper underline-links-hover">
                  <div class="card card--card card--media color-{{ section.settings.color_scheme }} gradient">
                    
                    <!-- IMAGE -->
                    <div class="card__inner ratio">
                      <div class="card__media">
                        {% if product.featured_media %}
                          {{ product.featured_media | image_url: width: 300 | image_tag:
                            loading: 'lazy',
                            class: 'motion-reduce'
                          }}
                        {% endif %}
                      </div>
                    </div>

                    <!-- INFO -->
                    <div class="card__content">
                      <div class="card__information">
                        <h3 class="card__heading h5">
                          <a href="{{ product.url }}" class="full-unstyled-link">
                            {{ product.title }}
                          </a>
                        </h3>

                        {% render 'price',
                          product: product,
                          use_variant: true,
                          show_badges: false
                        %}
                      </div>

                      <!-- BULK QUICK ADD -->
                      <quick-add-bulk
                        class="quick-add-bulk"
                        data-min="1"
                        data-index="{{ product.selected_or_first_available_variant.id }}"
                        id="quick-add-bulk-{{ product.id }}-{{ section.id }}"
                      >
                        {% render 'quantity-input',
                          variant: product.selected_or_first_available_variant,
                          min: 0
                        %}
                      </quick-add-bulk>

                    </div>
                  </div>
                </div>
              </li>

            {% endunless %}
          {% endfor %}
        {% endfor %}
      </ul>

    {% else %}
      <p>No compatible collections assigned.</p>
    {% endif %}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const select = document.getElementById('CompatibleSort');
  const grid = document.getElementById('product-grid');
  if (!select || !grid) return;

  function sortItems(dir) {
    const items = Array.from(grid.querySelectorAll('.list__item'));
    items.sort((a, b) =>
      dir === 'asc'
        ? a.dataset.title.localeCompare(b.dataset.title)
        : b.dataset.title.localeCompare(a.dataset.title)
    );
    items.forEach(item => grid.appendChild(item));
  }

  sortItems('asc');

  select.addEventListener('change', () => {
    sortItems(select.value);
  });
});
</script>

{% schema %}
{
  "name": "Compatible Collections",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "default": "bulk",
      "options": [
        { "value": "bulk", "label": "Bulk (Qty + Modal)" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
