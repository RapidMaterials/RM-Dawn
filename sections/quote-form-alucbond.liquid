{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Two-column layout (desktop) */
  .quote-form__grid {
    display: grid;
    gap: 24px;
  }

  @media screen and (min-width: 750px) {
    .quote-form__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }
  }

  .quote-form__right {
    background: rgba(0,0,0,0.03);
    border-radius: 8px;
    padding: 20px;
  }

  .quote-form__right .rte p:first-child {
    margin-top: 0;
  }

  /* Checkbox group layout for sizes */
  .quote-form__checkboxes {
    display: grid;
    gap: 10px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact quote-form page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}

    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}

    <div class="quote-form__grid">
      <div class="quote-form__left">
        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}

          {%- comment -%} Quote identifiers {%- endcomment -%}
          <input type="hidden" name="contact[Form Type]" value="ALUCOBOND Quote Request">
          <input type="hidden" name="contact[Subject]" value="ALUCOBOND® Quote Request – {{ shop.name }}{% if page.title != blank %} – {{ page.title }}{% endif %}">
          <input type="hidden" name="contact[Page URL]" value="{{ canonical_url }}">

          {%- comment -%} Honeypot spam field {%- endcomment -%}
          <div style="position:absolute; left:-5000px;" aria-hidden="true">
            <label for="ContactForm-website">Website</label>
            <input id="ContactForm-website" type="text" name="contact[website]" tabindex="-1" autocomplete="off">
          </div>

          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              Thank you. Your quote request has been submitted. Our team will review and follow up shortly.
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          {%- comment -%} Contact name / phone {%- endcomment -%}
          <div class="contact__fields">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                aria-required="true"
                name="contact[Contact Name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Contact name"
                required
              >
              <label class="field__label" for="ContactForm-name">
                Name <span aria-hidden="true">*</span>
              </label>
            </div>

            <div class="field">
              <input
                type="tel"
                id="ContactForm-phone"
                class="field__input"
                autocomplete="tel"
                name="contact[Phone]"
                pattern="[0-9\-]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="Phone (optional)"
              >
              <label class="field__label" for="ContactForm-phone">Phone (optional)</label>
            </div>
          </div>

           {%- comment -%} Q8: Email address for quote {%- endcomment -%}
          <div class="field field--with-error">
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="Email address"
            >
            <label class="field__label" for="ContactForm-email">
            Email Address to send quote <span aria-hidden="true">*</span>
            </label>

            {%- if form.errors contains 'email' -%}
              <small class="contact__field-error" id="ContactForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </span>
              </small>
            {%- endif -%}
          </div>

          {%- comment -%} Q1: Project name {%- endcomment -%}
          <div class="field">
            <input
              class="field__input"
              type="text"
              id="ContactForm-project-name"
              name="contact[Project Name]"
              value="{{ form['Project Name'] }}"
              placeholder="Project name"
              required
              aria-required="true"
            >
            <label class="field__label" for="ContactForm-project-name">
              What is the name of your project? <span aria-hidden="true">*</span>
            </label>
          </div>

          {%- comment -%} Q3: Size / thickness inquiry (multi-select checkboxes) {%- endcomment -%}
          <div class="field">
            <label class="field__label" style="display:block; margin-bottom: 8px;">
              What size are you inquiring about? <span aria-hidden="true">*</span>
            </label>

            <div class="quote-form__checkboxes">
              <label>
                <input
                  type="checkbox"
                  name="contact[Size - 4mm FR]"
                  value="Yes"
                  {% if form['Size - 4mm FR'] == 'Yes' %}checked{% endif %}
                >
                4mm FR
              </label>

              <label>
                <input
                  type="checkbox"
                  name="contact[Size - 0.040]"
                  value="Yes"
                  {% if form['Size - 0.040'] == 'Yes' %}checked{% endif %}
                >
                0.040
              </label>

              <label>
                <input
                  type="checkbox"
                  name="contact[Size - 0.063]"
                  value="Yes"
                  {% if form['Size - 0.063'] == 'Yes' %}checked{% endif %}
                >
                0.063
              </label>

              <label>
                <input
                  type="checkbox"
                  name="contact[Size - 0.080]"
                  value="Yes"
                  {% if form['Size - 0.080'] == 'Yes' %}checked{% endif %}
                >
                0.080
              </label>
            </div>

            <div class="caption-large" style="margin-top: 8px;">
              Select all that apply.
            </div>
          </div>

          {%- comment -%} Q4: Color inquiry {%- endcomment -%}
          <div class="field">
            <input
              class="field__input"
              type="text"
              id="ContactForm-color"
              name="contact[Color]"
              value="{{ form['Color'] }}"
              placeholder="Color name / finish"
              required
              aria-required="true"
            >
            <label class="field__label" for="ContactForm-color">
              What color are you inquiring about? <span aria-hidden="true">*</span>
            </label>
          </div>

          {%- comment -%} Q5: Open to other colors? {%- endcomment -%}
          <div class="field">
            <select class="field__input" id="ContactForm-alt-colors" name="contact[Open to Alternate Colors]" required aria-required="true">
              <option value="" {% if form['Open to Alternate Colors'] == blank %}selected{% endif %}>Select an option</option>
              <option value="Yes" {% if form['Open to Alternate Colors'] == 'Yes' %}selected{% endif %}>Yes</option>
              <option value="No" {% if form['Open to Alternate Colors'] == 'No' %}selected{% endif %}>No</option>
            </select>
            <label class="field__label" for="ContactForm-alt-colors">
              Are you open to other color options to shorten your lead time? <span aria-hidden="true">*</span>
            </label>
          </div>

          {%- comment -%} Q6: Quantity of sheets + helper sizes {%- endcomment -%}
          <div class="field">
            <input
              class="field__input"
              type="number"
              min="1"
              step="1"
              id="ContactForm-qty"
              name="contact[Sheet Quantity]"
              value="{{ form['Sheet Quantity'] }}"
              placeholder="Number of sheets"
              required
              aria-required="true"
            >
            <label class="field__label" for="ContactForm-qty">
              How many sheets are you needing for your project? <span aria-hidden="true">*</span>
            </label>
          </div>

          {%- comment -%} Q7: Ship-to address {%- endcomment -%}
          <div class="field">
            <textarea
              rows="4"
              id="ContactForm-ship-to"
              class="text-area field__input"
              name="contact[Ship To Address]"
              placeholder="Company / Name, Street, City, State, Zip"
              required
              aria-required="true"
            >{{ form['Ship To Address'] }}</textarea>
            <label class="form__label field__label" for="ContactForm-ship-to">
              What is the ship to address for this quote? <span aria-hidden="true">*</span>
            </label>
          </div>

         

          {%- comment -%} Additional info {%- endcomment -%}
          <div class="field">
            <textarea
              rows="6"
              id="ContactForm-body"
              class="text-area field__input"
              name="contact[body]"
              placeholder="Is there any additional information we need?"
            >{{- form.body -}}</textarea>

            <label class="form__label field__label" for="ContactForm-body">
              Is there any additional information we need?
            </label>
          </div>

          <div class="contact__button">
            <button type="submit" class="button">
              Request quote
            </button>
          </div>

        {%- endform -%}
      </div>

      {%- if section.settings.right_heading != blank or section.settings.right_richtext != blank -%}
        <aside class="quote-form__right">
          {%- if section.settings.right_heading != blank -%}
            <h3 class="h2">{{ section.settings.right_heading }}</h3>
          {%- endif -%}

          {%- if section.settings.right_richtext != blank -%}
            <div class="rte">
              {{ section.settings.right_richtext }}
            </div>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quote Form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Quote form",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "Right column content"
    },
    {
      "type": "inline_richtext",
      "id": "right_heading",
      "label": "Right column heading",
      "default": "Request a Quote"
    },
    {
      "type": "richtext",
      "id": "right_richtext",
      "label": "Right column text",
      "default": "<p>Add helpful details here like lead times, sheet sizes, freight notes, and what happens after submission.</p>"
    },

    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Quote Form - Alucobond"
    }
  ]
}
{% endschema %}