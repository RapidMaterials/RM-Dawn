{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Two-column layout (desktop) */
  .quote-form__grid {
    display: grid;
    gap: 24px;
  }

  @media screen and (min-width: 750px) {
    .quote-form__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }
  }

  .quote-form__right {
    background: rgba(0,0,0,0.03);
    border-radius: 8px;
    padding: 20px;
  }

  .quote-form__right .rte p:first-child {
    margin-top: 0;
  }

  /* Checkbox group layout for sizes */
  .quote-form__checkboxes {
    display: grid;
    gap: 10px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact quote-form page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}

    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}

    <div class="quote-form__grid">
      <div class="quote-form__left">
        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}

          {%- comment -%} Quote identifiers {%- endcomment -%}
          <input type="hidden" name="contact[Form Type]" value="ALUCOBOND Quote Request">
          <input type="hidden" name="contact[Subject]" value="ALUCOBOND® Quote Request – {{ shop.name }}{% if page.title != blank %} – {{ page.title }}{% endif %}">
          <input type="hidden" name="contact[Page URL]" value="{{ canonical_url }}">

          {%- comment -%} Honeypot spam field {%- endcomment -%}
          <div style="position:absolute; left:-5000px;" aria-hidden="true">
            <label for="ContactForm-website">Website</label>
            <input id="ContactForm-website" type="text" name="contact[website]" tabindex="-1" autocomplete="off">
          </div>

          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              Thank you. Your quote request has been submitted. Our team will review and follow up shortly.
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          {%- comment -%} Contact name / phone {%- endcomment -%}
          <div class="contact__fields">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                aria-required="true"
                name="contact[Contact Name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Contact name"
                required
              >
              <label class="field__label" for="ContactForm-name">
                Name <span aria-hidden="true">*</span>
              </label>
            </div>

            <div class="field">
              <input
                type="tel"
                id="ContactForm-phone"
                class="field__input"
                autocomplete="tel"
                name="contact[Phone]"
                pattern="[0-9\-]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="Phone (optional)"
              >
              <label class="field__label" for="ContactForm-phone">Phone (optional)</label>
            </div>
          </div>

           {%- comment -%} Q8: Email address for quote {%- endcomment -%}
          <div class="field field--with-error">
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="Email address"
            >
            <label class="field__label" for="ContactForm-email">
            Email Address to send quote <span aria-hidden="true">*</span>
            </label>

            {%- if form.errors contains 'email' -%}
              <small class="contact__field-error" id="ContactForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </span>
              </small>
            {%- endif -%}
          </div>

          {%- comment -%} Q1: Project name {%- endcomment -%}
          <div class="field">
            <input
              class="field__input"
              type="text"
              id="ContactForm-project-name"
              name="contact[Project Name]"
              value="{{ form['Project Name'] }}"
              placeholder="Project name"
              required
              aria-required="true"
            >
            <label class="field__label" for="ContactForm-project-name">
              What is the name of your project? <span aria-hidden="true">*</span>
            </label>
          </div>
<div class="field">
  <fieldset style="border: 0; padding: 0; margin: 0;">
    <legend style="font-size: 1.6rem; font-weight: 500; padding:1.5rem 1.5rem .5rem 2rem">
      What is your target delivery date, and is it flexible?
      <span aria-hidden="true">*</span>
    </legend>

    <div style="display: grid; gap: 16px;">

      <!-- Date -->
      <div class="date-wrapper" style="display:flex;justify-content: space-around;margin-bottom:10px;">
      <div>
        <input
          class="field__input"
          type="date"
          id="ContactForm-target-date"
          name="contact[Target Delivery Date]"
          value="{{ form['Target Delivery Date'] }}"
          required 
          style="    padding: 10px;  background-color: #eeeeee;"
        >
      </div>

      <!-- Radios -->
      <div style="display: flex; gap: 5px; flex-wrap: wrap;">
        <label style="display: flex; align-items: center; gap: 8px;">
          <input
            type="radio"
            name="contact[Delivery Date Flexibility]"
            value="Flexible"
            {% if form['Delivery Date Flexibility'] == 'Flexible' %}checked{% endif %}
            required
          >
          Flexible
        </label>

        <label style="display: flex; align-items: center; gap: 8px;">
          <input
            type="radio"
            name="contact[Delivery Date Flexibility]"
            value="Firm date"
            {% if form['Delivery Date Flexibility'] == 'Firm date' %}checked{% endif %}
          >
          Firm date
        </label>
      </div>
  </div>
    </div>
  </fieldset>
</div>

          {%- comment -%} Q7: Ship-to address {%- endcomment -%}
          <div class="field">
            <textarea
              rows="4"
              id="ContactForm-ship-to"
              class="text-area field__input"
              name="contact[Ship To Address]"
              placeholder="Company / Name, Street, City, State, Zip"
              required
              aria-required="true"
            >{{ form['Ship To Address'] }}</textarea>
            <label class="form__label field__label" for="ContactForm-ship-to">
              What is the ship to address for this quote? <span aria-hidden="true">*</span>
            </label>
          </div>

         
      



{%- comment -%} Line items (up to 3) {%- endcomment -%}
<div class="quote-form__group" style="margin: 0 0 2rem;">
  <h2 class="form__label" style="margin: 0 0 10px;    font-size: 1.2em;
    font-weight: bold;
    color: #245ba8;">
    Materials Needed <span aria-hidden="true">*</span>
  </h2>

  {%- for i in (1..3) -%}
    {%- capture key_thickness -%}Line Item {{ i }} - Thickness{%- endcapture -%}
    {%- capture key_color -%}Line Item {{ i }} - Color / Finish{%- endcapture -%}
    {%- capture key_qty -%}Line Item {{ i }} - Sheet Qty{%- endcapture -%}

    <div style="border: 1px solid #a5a5a5; padding: 14px; margin-bottom: 14px;  padding:1.5rem; background-color:#eeeeee;">
      <p class="form__label" style="margin: 0 0 10px 0; font-weight:bold; color:#000;">Material {{ i }}</p>

      <div class="field" style="margin-bottom:10px;">
        <select style="padding:0 1.5rem;" class="field__input" id="LineItem-{{ i }}-size" name="contact[{{ key_thickness }}]">
          <option value="" {% if form[key_thickness] == blank %}selected{% endif %}>Select thickness / series</option>
          <option value="4mm FR" {% if form[key_thickness] == '4mm FR' %}selected{% endif %}>4mm FR</option>
          <option value="0.040 AXCENT" {% if form[key_thickness] == '0.040 AXCENT' %}selected{% endif %}>0.040 AXCENT</option>
          <option value="0.063 AXCENT" {% if form[key_thickness] == '0.063 AXCENT' %}selected{% endif %}>0.063 AXCENT</option>
          <option value="0.080 AXCENT" {% if form[key_thickness] == '0.080 AXCENT' %}selected{% endif %}>0.080 AXCENT</option>
        </select>
        <label style="display:none;"  class="field__label" for="LineItem-{{ i }}-size">Thickness / series</label>
      </div>

      <div class="field" style="margin-bottom:10px;">
        <input
          class="field__input"
          type="text"
          id="LineItem-{{ i }}-color"
          name="contact[{{ key_color }}]"
          value="{{ form[key_color] }}"
          placeholder="e.g., Medium Bronze, Custom, etc."
        >
        <label class="field__label" for="LineItem-{{ i }}-color">Color / finish</label>
      </div>

      <div class="field" style="margin-bottom:0px;">
        <input
          class="field__input"
          type="number"
          min="1"
          step="1"
          id="LineItem-{{ i }}-qty"
          name="contact[{{ key_qty }}]"
          value="{{ form[key_qty] }}"
          placeholder="0"
        >
        <label class="field__label" for="LineItem-{{ i }}-qty">Sheet quantity</label>
      </div>
    </div>
  {%- endfor -%}

  <div class="caption-large">
    If you need more than 3 line items, list the additional ones in the notes field below.
  </div>
</div>

{%- comment -%} Q5: Color flexibility (radio buttons) {%- endcomment -%}
<div class="field">
  <fieldset style="border: 0; padding: 0; margin: 0;">
      <legend style="font-size: 1.6rem; font-weight: 500; padding:1.5rem 1.5rem .5rem 2rem">
      Are your color requirements flexible? <span aria-hidden="true">*</span>
    </legend>

    <div style="display: flex; gap: 5px; flex-wrap: wrap; padding:0 1.5rem 1.5rem 1.5rem"">
      <label style="display: flex; align-items: center; gap: 6px;">
        <input
          type="radio"
          name="contact[Color Flexibility]"
          value="Yes"
          {% if form['Color Flexibility'] == 'Yes' %}checked{% endif %}
          required
        >
        Yes
      </label>

      <label style="display: flex; align-items: center; gap: 6px;">
        <input
          type="radio"
          name="contact[Color Flexibility]"
          value="No"
          {% if form['Color Flexibility'] == 'No' %}checked{% endif %}
        >
        No
      </label>
    </div>
  </fieldset>
</div>




          {%- comment -%} Additional info {%- endcomment -%}
          <div class="field">
            <textarea
              rows="6"
              id="ContactForm-body"
              class="text-area field__input"
              name="contact[body]"
              placeholder="Is there any additional information we need?"
            >{{- form.body -}}</textarea>

            <label class="form__label field__label" for="ContactForm-body">
              Additional project details (optional)
            </label>
          </div>

          <div class="contact__button">
            <button type="submit" class="button">
              Request quote
            </button>
          </div>

        {%- endform -%}
      </div>

      {%- if section.settings.right_heading != blank or section.settings.right_richtext != blank -%}
        <aside class="quote-form__right">
          {%- if section.settings.right_heading != blank -%}
            <h3 class="h2">{{ section.settings.right_heading }}</h3>
          {%- endif -%}

          {%- if section.settings.right_richtext != blank -%}
            <div class="rte">
              {{ section.settings.right_richtext }}
            </div>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quote Form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Quote form",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "Right column content"
    },
    {
      "type": "inline_richtext",
      "id": "right_heading",
      "label": "Right column heading",
      "default": "Request a Quote"
    },
    {
      "type": "richtext",
      "id": "right_richtext",
      "label": "Right column text",
      "default": "<p>Add helpful details here like lead times, sheet sizes, freight notes, and what happens after submission.</p>"
    },

    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Quote Form - Alucobond"
    }
  ]
}
{% endschema %}