{%- style -%}
  .trust-strip-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    border-top: 1px solid rgba(0,0,0,.08);
  }

  .trust-strip-{{ section.id }} .trust-strip__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
  }

  .trust-strip-{{ section.id }} .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
    align-items: stretch;
  }

  .trust-strip-{{ section.id }} .trust-strip__item {
    display: flex;
    align-items: {% if section.settings.icon_position == 'top' %}flex-start{% else %}center{% endif %};
    gap: {% if section.settings.icon_position == 'top' %}12px{% else %}16px{% endif %};
    padding: 14px 16px;
    border-radius: {{ section.settings.card_radius }}px;
    background: {% if section.settings.use_cards %}{{ section.settings.card_background }}{% else %}transparent{% endif %};
    border: 1px solid {% if section.settings.use_cards %}{{ section.settings.card_border }}{% else %}transparent{% endif %};
    min-height: 84px;
    flex-direction: {% if section.settings.icon_position == 'top' %}column{% else %}row{% endif %};
    text-align: {% if section.settings.icon_position == 'top' %}center{% else %}left{% endif %};
  }

  .trust-strip-{{ section.id }} .trust-strip__icon-wrap {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    flex: 0 0 {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
    margin-top: {% if section.settings.icon_position == 'left' %}2px{% else %}0{% endif %};
  }

  .trust-strip-{{ section.id }} .trust-strip__icon-wrap svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    stroke: currentColor;
    stroke-width: 1.9;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .trust-strip-{{ section.id }} .trust-strip__icon-wrap img {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: block;
  }

  .trust-strip-{{ section.id }} .trust-strip__content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    align-items: {% if section.settings.icon_position == 'top' %}center{% else %}flex-start{% endif %};
  }

  .trust-strip-{{ section.id }} .trust-strip__heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  .trust-strip-{{ section.id }} .trust-strip__subtext {
    font-size: {{ section.settings.subtext_size }}px;
    font-weight: {{ section.settings.subtext_weight }};
    line-height: 1.35;
    color: {{ section.settings.subtext_color }};
    margin: 0;
  }

  .trust-strip-{{ section.id }} .trust-strip__content a {
    color: inherit;
    text-decoration: none;
  }

  .trust-strip-{{ section.id }} .trust-strip__content a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .trust-strip-{{ section.id }} .trust-strip__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .trust-strip-{{ section.id }} .trust-strip__inner {
      padding: {{ section.settings.padding_y_mobile }}px {{ section.settings.padding_x_mobile }}px;
    }

    .trust-strip-{{ section.id }} .trust-strip__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .trust-strip-{{ section.id }} .trust-strip__item {
      min-height: 72px;
      padding: 12px 14px;
      text-align: left;
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }

    .trust-strip-{{ section.id }} .trust-strip__content {
      align-items: flex-start;
    }

    .trust-strip-{{ section.id }} .trust-strip__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .trust-strip-{{ section.id }} .trust-strip__subtext {
      font-size: {{ section.settings.subtext_size_mobile }}px;
    }

    .trust-strip-{{ section.id }} .trust-strip__icon-wrap {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
      flex: 0 0 {{ section.settings.icon_size_mobile }}px;
    }

    .trust-strip-{{ section.id }} .trust-strip__icon-wrap svg,
    .trust-strip-{{ section.id }} .trust-strip__icon-wrap img {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="trust-strip-{{ section.id }}">
  <div class="trust-strip__inner">
    <div class="trust-strip__grid">
      {%- for block in section.blocks -%}
        <div class="trust-strip__item" {{ block.shopify_attributes }}>
          <div class="trust-strip__icon-wrap">
            {%- if block.settings.custom_icon != blank -%}
              {{
                block.settings.custom_icon
                | image_url: width: 100
                | image_tag: alt: block.settings.item_heading, loading: 'lazy'
              }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-3z"></path></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 17H6a2 2 0 0 1-2-2V7h10v10z"></path>
                    <path d="M14 11h3l3 3v3h-2"></path>
                    <circle cx="7.5" cy="17.5" r="1.5"></circle>
                    <circle cx="17.5" cy="17.5" r="1.5"></circle>
                  </svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                {%- when 'box' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.5-8 4.5-8-4.5L12 3z"></path><path d="M4 7.5V16.5L12 21l8-4.5V7.5"></path></svg>
                {%- when 'tool' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4"></path></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3z"></path></svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
                {%- when 'quote' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 11H5v-1a4 4 0 0 1 4-4"></path>
                    <path d="M19 11h-4v-1a4 4 0 0 1 4-4"></path>
                    <path d="M5 11h4v6H5z"></path>
                    <path d="M15 11h4v6h-4z"></path>
                  </svg>
                {%- when 'award' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="5"></circle><path d="M9 13l-1 8 4-2 4 2-1-8"></path></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>

          <div class="trust-strip__content">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">
                {%- if block.settings.item_heading != blank -%}
                  <div class="trust-strip__heading">{{ block.settings.item_heading }}</div>
                {%- endif -%}
                {%- if block.settings.item_subtext != blank -%}
                  <div class="trust-strip__subtext">{{ block.settings.item_subtext }}</div>
                {%- endif -%}
              </a>
            {%- else -%}
              {%- if block.settings.item_heading != blank -%}
                <div class="trust-strip__heading">{{ block.settings.item_heading }}</div>
              {%- endif -%}
              {%- if block.settings.item_subtext != blank -%}
                <div class="trust-strip__subtext">{{ block.settings.item_subtext }}</div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust / Value strip",
  "tag": "section",
  "class": "section-trust-value-strip",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "default": 1600
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Desktop horizontal padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Desktop vertical padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Mobile horizontal padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "label": "Mobile vertical padding",
      "min": 8,
      "max": 28,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between items",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "left", "label": "Left of text" },
        { "value": "top", "label": "Above text" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Desktop icon size",
      "min": 16,
      "max": 60,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Mobile icon size",
      "min": 16,
      "max": 50,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Desktop subtext size",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "subtext_size_mobile",
      "label": "Mobile subtext size",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading font weight",
      "min": 300,
      "max": 800,
      "step": 100,
      "default": 700
    },
    {
      "type": "range",
      "id": "subtext_weight",
      "label": "Subtext font weight",
      "min": 300,
      "max": 700,
      "step": 100,
      "default": 400
    },
    {
      "type": "checkbox",
      "id": "use_cards",
      "label": "Use card backgrounds",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#4b5563"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Fallback text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2f67b1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Value item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "box", "label": "Box" },
            { "value": "tool", "label": "Tool" },
            { "value": "star", "label": "Star" },
            { "value": "quote", "label": "Quote" },
            { "value": "award", "label": "Award" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "item_heading",
          "label": "Heading",
          "default": "Fast Shipping"
        },
        {
          "type": "text",
          "id": "item_subtext",
          "label": "Subtext",
          "default": "On in-stock products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust / Value strip",
      "blocks": [
        {
          "type": "value_item",
          "settings": {
            "icon": "award",
            "item_heading": "45+ Years",
            "item_subtext": "Serving the construction industry"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "icon": "truck",
            "item_heading": "Fast Shipping",
            "item_subtext": "On in-stock products"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "icon": "tool",
            "item_heading": "Contractor Focused",
            "item_subtext": "Trade-ready product selection"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "icon": "quote",
            "item_heading": "Quick Order",
            "item_subtext": "Quote support available"
          }
        }
      ]
    }
  ]
}
{% endschema %}