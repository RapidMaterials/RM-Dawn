{%- style -%}
  .trust-strip-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .trust-strip-{{ section.id }} .trust-strip__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
  }

  .trust-strip-{{ section.id }} .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
    align-items: stretch;
  }

  .trust-strip-{{ section.id }} .trust-strip__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: {{ section.settings.card_radius }}px;
    background: {% if section.settings.use_cards %}{{ section.settings.card_background }}{% else %}transparent{% endif %};
    border: 1px solid {% if section.settings.use_cards %}{{ section.settings.card_border }}{% else %}transparent{% endif %};
    min-height: 72px;
  }

  .trust-strip-{{ section.id }} .trust-strip__icon-wrap {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
  }

  .trust-strip-{{ section.id }} .trust-strip__icon-wrap svg {
    width: 26px;
    height: 26px;
    stroke: currentColor;
    stroke-width: 1.9;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .trust-strip-{{ section.id }} .trust-strip__icon-wrap img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    display: block;
  }

  .trust-strip-{{ section.id }} .trust-strip__text {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.35;
    font-weight: {{ section.settings.text_weight }};
    color: {{ section.settings.text_color }};
  }

  .trust-strip-{{ section.id }} .trust-strip__item a {
    color: inherit;
    text-decoration: none;
  }

  .trust-strip-{{ section.id }} .trust-strip__item a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .trust-strip-{{ section.id }} .trust-strip__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .trust-strip-{{ section.id }} .trust-strip__inner {
      padding: {{ section.settings.padding_y_mobile }}px {{ section.settings.padding_x_mobile }}px;
    }

    .trust-strip-{{ section.id }} .trust-strip__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .trust-strip-{{ section.id }} .trust-strip__item {
      min-height: 64px;
      padding: 12px 14px;
    }

    .trust-strip-{{ section.id }} .trust-strip__text {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="trust-strip-{{ section.id }}">
  <div class="trust-strip__inner">
    <div class="trust-strip__grid">
      {%- for block in section.blocks -%}
        <div class="trust-strip__item" {{ block.shopify_attributes }}>
          <div class="trust-strip__icon-wrap">
            {%- if block.settings.custom_icon != blank -%}
              {{
                block.settings.custom_icon
                | image_url: width: 64
                | image_tag: alt: block.settings.text, loading: 'lazy'
              }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-3z"></path>
                  </svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 17H6a2 2 0 0 1-2-2V7h10v10z"></path>
                    <path d="M14 11h3l3 3v3h-2"></path>
                    <circle cx="7.5" cy="17.5" r="1.5"></circle>
                    <circle cx="17.5" cy="17.5" r="1.5"></circle>
                  </svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>
                  </svg>
                {%- when 'box' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l8 4.5-8 4.5-8-4.5L12 3z"></path>
                    <path d="M4 7.5V16.5L12 21l8-4.5V7.5"></path>
                    <path d="M12 12v9"></path>
                  </svg>
                {%- when 'tool' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.2 2.2-2.9-.7-.7-2.9 2.5-2.3z"></path>
                  </svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3z"></path>
                  </svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                {%- when 'quote' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 11H5v-1a4 4 0 0 1 4-4"></path>
                    <path d="M19 11h-4v-1a4 4 0 0 1 4-4"></path>
                    <path d="M5 11h4v6H5z"></path>
                    <path d="M15 11h4v6h-4z"></path>
                  </svg>
                {%- when 'award' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="8" r="5"></circle>
                    <path d="M9 13l-1 8 4-2 4 2-1-8"></path>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
          </div>

          <div class="trust-strip__text">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust / Value strip",
  "tag": "section",
  "class": "section-trust-value-strip",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "default": 1600
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Desktop horizontal padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Desktop vertical padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Mobile horizontal padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "label": "Mobile vertical padding",
      "min": 8,
      "max": 28,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between items",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "use_cards",
      "label": "Use card backgrounds",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2f67b1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Desktop text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Mobile text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Value item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "box", "label": "Box" },
            { "value": "tool", "label": "Tool" },
            { "value": "star", "label": "Star" },
            { "value": "quote", "label": "Quote" },
            { "value": "award", "label": "Award" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Fast shipping on in-stock products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust / Value strip",
      "blocks": [
        {
          "type": "value_item",
          "settings": {
            "icon": "award",
            "text": "45+ years serving the construction industry"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "icon": "truck",
            "text": "Fast shipping on in-stock products"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "icon": "tool",
            "text": "Contractor-focused product selection"
          }
        },
        {
          "type": "value_item",
          "settings": {
            "icon": "quote",
            "text": "Quick order and quote support"
          }
        }
      ]
    }
  ]
}
{% endschema %}