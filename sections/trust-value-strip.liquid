{%- style -%}

.trust-strip-{{ section.id }}{
  background:{{ section.settings.background_color }};
  color:{{ section.settings.text_color }};
  border-top:1px solid rgba(0,0,0,.08);
}

.trust-strip-{{ section.id }} .trust-strip__inner{
  max-width:{{ section.settings.max_width }}px;
  margin:0 auto;
  padding:{{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
}

.trust-strip-{{ section.id }} .trust-strip__grid{
  display:grid;
  grid-template-columns:repeat({{ section.settings.columns_desktop }},minmax(0,1fr));
  gap:{{ section.settings.grid_gap }}px;
  align-items:center;
}

.trust-strip-{{ section.id }} .trust-strip__item{
  display:flex;
  align-items:center;
  gap:14px;
  padding:12px 14px;
  border-radius:{{ section.settings.card_radius }}px;
  background:{% if section.settings.use_cards %}{{ section.settings.card_background }}{% else %}transparent{% endif %};
  border:1px solid {% if section.settings.use_cards %}{{ section.settings.card_border }}{% else %}transparent{% endif %};
}

.trust-strip-{{ section.id }} .trust-strip__icon-wrap{
  width:{{ section.settings.icon_size }}px;
  height:{{ section.settings.icon_size }}px;
  flex:0 0 {{ section.settings.icon_size }}px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:{{ section.settings.icon_color }};
}

.trust-strip-{{ section.id }} .trust-strip__icon-wrap svg{
  width:{{ section.settings.icon_size }}px;
  height:{{ section.settings.icon_size }}px;
  stroke:currentColor;
  stroke-width:1.9;
  fill:none;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.trust-strip-{{ section.id }} .trust-strip__icon-wrap img{
  width:{{ section.settings.icon_size }}px;
  height:{{ section.settings.icon_size }}px;
  object-fit:contain;
}

.trust-strip-{{ section.id }} .trust-strip__text{
  font-size:{{ section.settings.text_size }}px;
  font-weight:{{ section.settings.text_weight }};
  line-height:1.35;
  color:{{ section.settings.text_color }};
}

.trust-strip-{{ section.id }} .trust-strip__item a{
  color:inherit;
  text-decoration:none;
}

.trust-strip-{{ section.id }} .trust-strip__item a:hover{
  text-decoration:underline;
}

@media screen and (max-width:989px){
  .trust-strip-{{ section.id }} .trust-strip__grid{
    grid-template-columns:repeat({{ section.settings.columns_tablet }},minmax(0,1fr));
  }
}

@media screen and (max-width:749px){

  .trust-strip-{{ section.id }} .trust-strip__inner{
    padding:{{ section.settings.padding_y_mobile }}px {{ section.settings.padding_x_mobile }}px;
  }

  .trust-strip-{{ section.id }} .trust-strip__grid{
    grid-template-columns:1fr;
    gap:10px;
  }

  .trust-strip-{{ section.id }} .trust-strip__text{
    font-size:{{ section.settings.text_size_mobile }}px;
  }

}

{%- endstyle -%}


<section class="trust-strip-{{ section.id }}">
  <div class="trust-strip__inner">
    <div class="trust-strip__grid">

      {% for block in section.blocks %}

        <div class="trust-strip__item" {{ block.shopify_attributes }}>

          <div class="trust-strip__icon-wrap">

            {% if block.settings.custom_icon != blank %}
              {{
                block.settings.custom_icon
                | image_url: width: 80
                | image_tag: alt: block.settings.text
              }}
            {% else %}

              {% case block.settings.icon %}

              {% when 'shield' %}
              <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-3z"/></svg>

              {% when 'truck' %}
              <svg viewBox="0 0 24 24">
              <path d="M10 17H6a2 2 0 0 1-2-2V7h10v10z"/>
              <path d="M14 11h3l3 3v3h-2"/>
              <circle cx="7.5" cy="17.5" r="1.5"/>
              <circle cx="17.5" cy="17.5" r="1.5"/>
              </svg>

              {% when 'clock' %}
              <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 7v5l3 2"/>
              </svg>

              {% when 'box' %}
              <svg viewBox="0 0 24 24">
              <path d="M12 3l8 4.5-8 4.5-8-4.5L12 3z"/>
              <path d="M4 7.5V16.5L12 21l8-4.5V7.5"/>
              </svg>

              {% when 'tool' %}
              <svg viewBox="0 0 24 24">
              <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4"/>
              </svg>

              {% when 'star' %}
              <svg viewBox="0 0 24 24">
              <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z"/>
              </svg>

              {% when 'award' %}
              <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="5"/>
              <path d="M9 13l-1 8 4-2 4 2-1-8"/>
              </svg>

              {% else %}
              <svg viewBox="0 0 24 24">
              <path d="M20 6L9 17l-5-5"/>
              </svg>

              {% endcase %}

            {% endif %}

          </div>

          <div class="trust-strip__text">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {% else %}
              {{ block.settings.text }}
            {% endif %}
          </div>

        </div>

      {% endfor %}

    </div>
  </div>
</section>



