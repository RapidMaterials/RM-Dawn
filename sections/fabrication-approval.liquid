<style>
  .fab-approval-page {
    max-width: 900px;
    margin: 50px auto 80px;
    padding: 0 24px;
    font-family: Arial, Helvetica, sans-serif;
    color: #222;
  }

  .fab-header {
    text-align: center;
    margin-bottom: 35px;
  }

  .fab-header h1 {
    font-size: 36px;
    margin: 0 0 8px;
  }

  .fab-order {
    font-size: 18px;
    color: #555;
  }

  .fab-intro {
    max-width: 760px;
    margin: 0 auto 35px;
    text-align: center;
    font-size: 16px;
    line-height: 1.6;
  }

  .fab-item {
    width: 100%;
    border: 1px solid #ddd;
    border-collapse: collapse;
    margin: 0 0 22px;
    background: #fff;
  }

  .fab-item-info {
    width: 40%;
    padding: 28px 30px;
    vertical-align: middle;
    background: #f5f5f5;
    border-right: 1px solid #ddd;
  }

  .fab-item-drawing {
    width: 60%;
    padding: 26px 30px;
    vertical-align: middle;
    text-align: center;
    overflow: hidden;
  }

  .fab-item-name {
    font-size: 17px;
    font-weight: bold;
    line-height: 1.45;
    margin-bottom: 14px;
  }

  .fab-qty {
    font-size: 15px;
    font-weight: bold;
  }

  .fab-review-box {
    margin-top: 32px;
    padding: 24px;
    border: 1px solid #e4c66a;
    background: #fff8e6;
    text-align: center;
  }

  .fab-review-title {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .fab-buttons {
    margin-top: 22px;
  }

  .fab-button {
    display: inline-block;
    margin: 5px;
    padding: 14px 26px;
    border: 0;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
  }

  .fab-button:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .fab-approve {
    background: #2f6f3e;
    color: #fff;
  }

  .fab-modify {
    background: #555;
    color: #fff;
  }

  .fab-cancel {
    background: #ddd;
    color: #222;
  }

  .fab-modification-box {
    max-width: 700px;
    margin: 30px auto 0;
    padding: 25px;
    border: 1px solid #ddd;
    background: #f7f7f7;
  }

  .fab-modification-box textarea {
    width: 100%;
    min-height: 170px;
    box-sizing: border-box;
    padding: 14px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    border: 1px solid #bbb;
    border-radius: 4px;
  }

  .fab-success {
    max-width: 700px;
    margin: 80px auto;
    text-align: center;
  }

  .fab-success h1 {
    font-size: 34px;
    margin-bottom: 14px;
  }

  .fab-error {
    padding: 25px;
    background: #fff4f4;
    border: 1px solid #d7aaaa;
    text-align: center;
  }

  .drawing-wrap {
    display: inline-block;
    margin: 0 auto;
    padding: 10px 0;
  }

  /*
    Shopify theme table styles can leak into the fabrication diagrams.
    Remove those default borders here.
  */

  .fab-item-drawing table,
  .fab-item-drawing tr,
  .fab-item-drawing td {
    border-color: transparent;
  }

  .drawing-wrap table {
    border: none !important;
    border-collapse: collapse !important;
    margin: 0 auto;
  }

  .drawing-wrap td {
    border: none;
    box-shadow: none;
  }

  @media screen and (max-width: 700px) {

    .fab-approval-page {
      margin-top: 30px;
      padding: 0 15px;
    }

    .fab-item,
    .fab-item tbody,
    .fab-item tr,
    .fab-item td {
      display: block;
      width: 100% !important;
      box-sizing: border-box;
    }

    .fab-item-info {
      border-right: 0;
      border-bottom: 1px solid #ddd;
      padding: 22px;
    }

    .fab-item-drawing {
      padding: 25px 15px;
      overflow-x: auto;
    }

    .fab-header h1 {
      font-size: 28px;
    }

    .fab-button {
      display: block;
      width: 100%;
      box-sizing: border-box;
      margin: 8px 0;
    }

  }
</style>


<div class="fab-approval-page">


  <!-- ======================================================
       LOADING
       ====================================================== -->

  <div id="loading">
    Loading fabrication details...
  </div>



  <!-- ======================================================
       REVIEW SCREEN
       ====================================================== -->

  <div id="review-screen" style="display:none;">

    <div class="fab-header">

      <h1>Fabrication Approval</h1>

      <div class="fab-order">
        Order <strong id="display-order"></strong>
      </div>

    </div>


    <div class="fab-intro">
      Please carefully review the fabrication details and diagrams below.
      Verify all dimensions, quantities, orientations, and specifications
      before approving fabrication.
    </div>


    <div id="items-container"></div>


    <div class="fab-review-box">

      <div class="fab-review-title">
        Approval Required Before Fabrication
      </div>

      <div id="approval-description">
        Please confirm that all fabrication details shown above are correct.
      </div>


      <div class="fab-buttons">

        <button
          type="button"
          id="approve-button"
          class="fab-button fab-approve"
        >
          Approve
        </button>


        <button
          type="button"
          id="show-modify-button"
          class="fab-button fab-modify"
        >
          Request Modifications
        </button>

      </div>

    </div>


    <p
      style="
        text-align:center;
        margin-top:25px;
        font-size:14px;
        color:#555;
      "
    >
      <strong>
        Fabrication will not begin until your approval is received.
      </strong>
    </p>

  </div>



  <!-- ======================================================
       MODIFICATION SCREEN
       ====================================================== -->

  <div id="modify-screen" style="display:none;">

    <div class="fab-header">

      <h1>Request Fabrication Changes</h1>

      <div class="fab-order">
        Order <strong class="order-number"></strong>
      </div>

    </div>


    <div class="fab-modification-box">

      <p style="margin-top:0;">
        Please describe the changes that need to be made.
        Include the item and dimension being changed when applicable.
      </p>

      <textarea
        id="modifications"
        placeholder="Example: On the Hat Channel, change the 2&quot; depth to 2.5&quot;."
      ></textarea>


      <div class="fab-buttons">

        <button
          type="button"
          id="submit-modifications"
          class="fab-button fab-modify"
        >
          Submit Modifications
        </button>


        <button
          type="button"
          id="back-to-review"
          class="fab-button fab-cancel"
        >
          Back to Review
        </button>

      </div>

    </div>

  </div>



  <!-- ======================================================
       SUCCESS SCREEN
       ====================================================== -->

  <div
    id="success-screen"
    class="fab-success"
    style="display:none;"
  >

    <h1 id="success-title"></h1>

    <p
      id="success-message"
      style="font-size:17px;"
    ></p>

  </div>



  <!-- ======================================================
       ERROR SCREEN
       ====================================================== -->

  <div id="error-screen" style="display:none;">

    <div class="fab-error">

      <h2>
        Unable to Load Fabrication Approval
      </h2>

      <p>
        We were unable to load the fabrication information for this order.
        Please contact Rapid Materials for assistance.
      </p>

    </div>

  </div>



  <!-- ======================================================
       HIDDEN ZAPIER RESPONSE
       ====================================================== -->

  <iframe
    name="zapier-response"
    id="zapier-response"
    style="display:none;"
  ></iframe>



  <!-- ======================================================
       HIDDEN ZAPIER FORM
       ====================================================== -->

  <form
    id="zapier-form"
    action="https://hooks.zapier.com/hooks/catch/21037350/4hmzwbn/"
    method="POST"
    target="zapier-response"
    style="display:none;"
  >

    <input
      type="hidden"
      name="action"
      id="zapier-action"
    >

    <input
      type="hidden"
      name="order_number"
      id="zapier-order-number"
    >

    <input
      type="hidden"
      name="modifications"
      id="zapier-modifications"
    >

    <input
      type="hidden"
      name="items"
      id="zapier-items"
    >

  </form>


</div>



<script>
document.addEventListener('DOMContentLoaded', function () {


  /* =========================================================
     URL VARIABLES
     ========================================================= */

  const params = new URLSearchParams(window.location.search);

  const order = params.get('order');

  const requestedAction = params.get('action');

  const itemsParameter = params.get('items');

  let items = [];



  /* =========================================================
     BASIC VALIDATION
     ========================================================= */

  if (!order) {

    document.getElementById('loading').style.display =
      'none';

    document.getElementById('error-screen').style.display =
      'block';

    return;

  }


  document.getElementById('display-order').textContent =
    order;


  document
    .querySelectorAll('.order-number')
    .forEach(function(el) {

      el.textContent = order;

    });



  /* =========================================================
     READ ITEM DATA
     ========================================================= */

  if (itemsParameter) {

    try {

      items = JSON.parse(itemsParameter);

    }

    catch (error) {

      console.error(
        'Unable to parse fabrication items:',
        error
      );

    }

  }


  if (!Array.isArray(items)) {

    items = [];

  }



  /* =========================================================
     ESCAPE HTML
     ========================================================= */

  function escapeHtml(value) {

    if (
      value === undefined ||
      value === null
    ) {

      return '';

    }

    return String(value)

      .replace(/&/g, '&amp;')

      .replace(/</g, '&lt;')

      .replace(/>/g, '&gt;')

      .replace(/"/g, '&quot;')

      .replace(/'/g, '&#039;');

  }



  /* =========================================================
     CLEAN DIMENSION
     ========================================================= */

  function cleanDimension(value) {

    if (!value) {

      return '';

    }

    return String(value)

      .replace(/["″”“]/g, '')

      .trim();

  }



  /* =========================================================
     SAFE DIMENSION NUMBER
     ========================================================= */

  function dimensionNumber(value) {

    const number =
      parseFloat(
        cleanDimension(value)
      );

    if (isNaN(number)) {

      return 0;

    }

    return number;

  }



  /* =========================================================
     NO DRAWING
     ========================================================= */

  function noDrawing() {

    return `
      <div
        style="
          color:#777;
          padding:25px;
          font-size:14px;
        "
      >
        Fabrication diagram unavailable.
      </div>
    `;

  }



  /* =========================================================
     MANUAL IMAGE
     ========================================================= */

  function drawManualImage(item) {

    return `
      <img
        src="${escapeHtml(item.img_url)}"
        alt="Fabrication Diagram"
        style="
          max-width:100%;
          max-height:350px;
          width:auto;
          height:auto;
        "
      >
    `;

  }



  /* =========================================================
     U CHANNEL
     ========================================================= */

  function drawUChannel(item) {

    const web =
      cleanDimension(item.web);

    const legs =
      cleanDimension(item.legs);


    if (!web || !legs) {

      return noDrawing();

    }


    const width =
      Math.max(
        100,
        dimensionNumber(web) * 55
      );


    const height =
      Math.max(
        55,
        dimensionNumber(legs) * 55
      );


    return `

      <div
        class="drawing-wrap"
      >

        <table
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            margin:0 auto;
            border-collapse:collapse;
            border:none;
          "
        >

          <tr>

            <td
              style="
                width:55px;
                border:none !important;
                padding:0;
              "
            ></td>


            <td
              style="
                width:${width}px;
                border:none !important;
                text-align:center;
                font-size:20px;
                padding:0 0 10px 0;
                white-space:nowrap;
              "
            >
              ${escapeHtml(web)}"
            </td>


            <td
              style="
                width:55px;
                border:none !important;
                padding:0;
              "
            ></td>

          </tr>


          <tr>

            <td
              style="
                width:55px;
                border:none !important;
                padding:0 10px 0 0;
                text-align:right;
                vertical-align:middle;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(legs)}"
            </td>


            <td
              style="
                width:${width}px;
                height:${height}px;
                border:none;
                border-top:3px solid #111111 !important;
                border-left:3px solid #111111 !important;
                border-right:3px solid #111111 !important;
                border-bottom:none !important;
                padding:0;
              "
            >
              &nbsp;
            </td>


            <td
              style="
                width:55px;
                border:none !important;
                padding:0 0 0 10px;
                text-align:left;
                vertical-align:middle;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(legs)}"
            </td>

          </tr>

        </table>

      </div>

    `;

  }



  /* =========================================================
     HAT CHANNEL
     ========================================================= */

  function drawHatChannel(item) {

    const depth =
      cleanDimension(item.depth);

    const crown =
      cleanDimension(item.crown);

    const flange =
      cleanDimension(
        item.flange ||
        item.flanges
      );


    if (
      !depth ||
      !crown ||
      !flange
    ) {

      return noDrawing();

    }


    const crownWidth =
      Math.max(
        90,
        dimensionNumber(crown) * 45
      );


    const depthHeight =
      Math.max(
        55,
        dimensionNumber(depth) * 45
      );


    const flangeWidth =
      Math.max(
        40,
        dimensionNumber(flange) * 45
      );


    return `

      <div
        class="drawing-wrap"
      >

        <table
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            margin:0 auto;
            border-collapse:collapse;
            border:none;
          "
        >


          <tr>

            <td
              style="
                width:${flangeWidth}px;
                border:none !important;
                padding:0;
              "
            ></td>


            <td
              style="
                width:${crownWidth}px;
                border:none !important;
                padding:0 0 10px 0;
                text-align:center;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(crown)}"
            </td>


            <td
              style="
                width:${flangeWidth}px;
                border:none !important;
                padding:0;
              "
            ></td>

          </tr>



          <tr>

            <td
              style="
                width:${flangeWidth}px;
                height:${depthHeight}px;
                border:none;
                border-bottom:3px solid #111111 !important;
                border-right:3px solid #111111 !important;
                padding:0;
              "
            >
              &nbsp;
            </td>


            <td
              style="
                width:${crownWidth}px;
                height:${depthHeight}px;
                border:none;
                border-top:3px solid #111111 !important;
                padding:0;
                vertical-align:middle;
              "
            >

              <table
                width="100%"
                height="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  border:none;
                  border-collapse:collapse;
                "
              >

                <tr>

                  <td
                    style="
                      border:none !important;
                      text-align:left;
                      vertical-align:middle;
                      padding:0 0 0 7px;
                      font-size:18px;
                      white-space:nowrap;
                    "
                  >
                    ${escapeHtml(depth)}"
                  </td>


                  <td
                    style="
                      border:none !important;
                      text-align:right;
                      vertical-align:middle;
                      padding:0 7px 0 0;
                      font-size:18px;
                      white-space:nowrap;
                    "
                  >
                    ${escapeHtml(depth)}"
                  </td>

                </tr>

              </table>

            </td>


            <td
              style="
                width:${flangeWidth}px;
                height:${depthHeight}px;
                border:none;
                border-bottom:3px solid #111111 !important;
                border-left:3px solid #111111 !important;
                padding:0;
              "
            >
              &nbsp;
            </td>

          </tr>



          <tr>

            <td
              style="
                border:none !important;
                text-align:center;
                padding:7px 0 0 0;
                font-size:18px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(flange)}"
            </td>


            <td
              style="
                border:none !important;
              "
            ></td>


            <td
              style="
                border:none !important;
                text-align:center;
                padding:7px 0 0 0;
                font-size:18px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(flange)}"
            </td>

          </tr>


        </table>

      </div>

    `;

  }



  /* =========================================================
     Z GIRT
     ========================================================= */

  function drawZGirt(item) {

    const depth =
      cleanDimension(
        item.depth ||
        item.web
      );

    const flange =
      cleanDimension(
        item.flange ||
        item.flanges
      );


    if (!depth || !flange) {

      return noDrawing();

    }


    const depthWidth =
      Math.max(
        100,
        dimensionNumber(depth) * 55
      );


    const flangeHeight =
      Math.max(
        50,
        dimensionNumber(flange) * 55
      );


    return `

      <div
        class="drawing-wrap"
      >

        <table
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            margin:0 auto;
            border-collapse:collapse;
            border:none;
          "
        >


          <tr>

            <td
              style="
                width:55px;
                height:${flangeHeight}px;
                border:none !important;
                padding:0 10px 0 0;
                text-align:right;
                vertical-align:middle;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(flange)}"
            </td>


            <td
              style="
                width:${depthWidth}px;
                height:${flangeHeight}px;
                border:none;
                border-left:3px solid #111111 !important;
                border-bottom:3px solid #111111 !important;
                padding:0 0 7px 0;
                text-align:center;
                vertical-align:bottom;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(depth)}"
            </td>


            <td
              style="
                width:55px;
                height:${flangeHeight}px;
                border:none !important;
              "
            >
              &nbsp;
            </td>

          </tr>



          <tr>

            <td
              style="
                width:55px;
                height:${flangeHeight}px;
                border:none !important;
              "
            >
              &nbsp;
            </td>


            <td
              style="
                width:${depthWidth}px;
                height:${flangeHeight}px;
                border:none;
                border-right:3px solid #111111 !important;
              "
            >
              &nbsp;
            </td>


            <td
              style="
                width:55px;
                height:${flangeHeight}px;
                border:none !important;
                padding:0 0 0 10px;
                text-align:left;
                vertical-align:middle;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(flange)}"
            </td>

          </tr>


        </table>

      </div>

    `;

  }



  /* =========================================================
     SUPPORT / CLOSURE ANGLE
     ========================================================= */

  function drawAngle(item) {

    const horizontal =
      cleanDimension(
        item.horizontal ||
        item.depth ||
        item.mounting_leg
      );


    const vertical =
      cleanDimension(
        item.vertical ||
        item.leg ||
        item.panel_leg
      );


    if (
      !horizontal ||
      !vertical
    ) {

      return noDrawing();

    }


    const width =
      Math.max(
        100,
        dimensionNumber(horizontal) * 50
      );


    const height =
      Math.max(
        55,
        dimensionNumber(vertical) * 50
      );


    return `

      <div
        class="drawing-wrap"
      >

        <table
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            margin:0 auto;
            border-collapse:collapse;
            border:none;
          "
        >


          <tr>

            <td
              style="
                width:60px;
                height:${height}px;
                border:none !important;
                padding:0 10px 0 0;
                text-align:right;
                vertical-align:middle;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(vertical)}"
            </td>


            <td
              style="
                width:${width}px;
                height:${height}px;
                border:none;
                border-left:3px solid #111111 !important;
                border-bottom:3px solid #111111 !important;
                padding:0;
              "
            >
              &nbsp;
            </td>


            <td
              style="
                width:30px;
                border:none !important;
              "
            ></td>

          </tr>



          <tr>

            <td
              style="
                border:none !important;
              "
            ></td>


            <td
              style="
                border:none !important;
                text-align:center;
                padding:7px 0 0 0;
                font-size:20px;
                white-space:nowrap;
              "
            >
              ${escapeHtml(horizontal)}"
            </td>


            <td
              style="
                border:none !important;
              "
            ></td>

          </tr>


        </table>

      </div>

    `;

  }



  /* =========================================================
     DETERMINE DRAWING TYPE
     ========================================================= */

  function getDrawing(item) {


    if (item.img_url) {

      return drawManualImage(item);

    }


    const profile =
      String(
        item.profile || ''
      ).toLowerCase();


    const name =
      String(
        item.name || ''
      ).toLowerCase();



    /* U CHANNEL */

    if (

      profile === 'u' ||

      profile === 'u-channel' ||

      profile === 'u channel' ||

      name.includes('u channel')

    ) {

      return drawUChannel(item);

    }



    /* HAT CHANNEL */

    if (

      profile === 'hat' ||

      profile === 'hat-channel' ||

      profile === 'hat channel' ||

      name.includes('hat channel')

    ) {

      return drawHatChannel(item);

    }



    /* Z GIRT */

    if (

      profile === 'z' ||

      profile === 'z-girt' ||

      profile === 'z girt' ||

      name.includes('z girt')

    ) {

      return drawZGirt(item);

    }



    /* ANGLE */

    if (

      profile === 'angle' ||

      name.includes('support angle') ||

      name.includes('closure angle')

    ) {

      return drawAngle(item);

    }


    return noDrawing();

  }



  /* =========================================================
     RENDER ITEMS
     ========================================================= */

  function renderItems() {


    const container =
      document.getElementById(
        'items-container'
      );


    container.innerHTML = '';



    if (!items.length) {


      container.innerHTML = `

        <div
          style="
            padding:25px;
            border:1px solid #ddd;
            background:#f7f7f7;
            text-align:center;
            margin-bottom:20px;
          "
        >

          Fabrication details for Order
          <strong>
            ${escapeHtml(order)}
          </strong>

        </div>

      `;


      return;

    }



    items.forEach(function(item) {


      const quantity =
        item.quantity ||
        item.qty ||
        1;


      const table =
        document.createElement('table');


      table.className =
        'fab-item';


      table.setAttribute(
        'cellpadding',
        '0'
      );


      table.setAttribute(
        'cellspacing',
        '0'
      );


      table.innerHTML = `

        <tr>

          <td
            class="fab-item-info"
          >

            <div
              class="fab-item-name"
            >
              ${escapeHtml(item.name)}
            </div>


            <div
              class="fab-qty"
            >
              Quantity:
              ${escapeHtml(quantity)}
            </div>

          </td>


          <td
            class="fab-item-drawing"
          >

            ${getDrawing(item)}

          </td>

        </tr>

      `;


      container.appendChild(
        table
      );

    });



    /* SINGULAR / PLURAL */

    if (items.length > 1) {


      document
        .getElementById('approve-button')
        .textContent =
        'Approve All';


      document
        .getElementById('approval-description')
        .textContent =
        'Please confirm that all fabrication details and diagrams shown above are correct.';


    }

    else {


      document
        .getElementById('approve-button')
        .textContent =
        'Approve';


      document
        .getElementById('approval-description')
        .textContent =
        'Please confirm that the fabrication details and diagram shown above are correct.';


    }

  }



  /* =========================================================
     SUBMIT TO ZAPIER
     ========================================================= */

  function submitToZapier(
    actionValue,
    modificationsValue
  ) {


    document
      .getElementById('zapier-action')
      .value =
      actionValue;


    document
      .getElementById('zapier-order-number')
      .value =
      order;


    document
      .getElementById('zapier-modifications')
      .value =
      modificationsValue || '';


    document
      .getElementById('zapier-items')
      .value =
      JSON.stringify(items);


    document
      .getElementById('zapier-form')
      .submit();

  }



  /* =========================================================
     APPROVE BUTTON
     ========================================================= */

  document
    .getElementById('approve-button')
    .addEventListener(
      'click',
      function () {


        const button =
          this;


        button.disabled =
          true;


        button.textContent =
          'Submitting...';



        submitToZapier(
          'approved',
          ''
        );



        setTimeout(
          function () {


            document
              .getElementById('review-screen')
              .style.display =
              'none';


            document
              .getElementById('modify-screen')
              .style.display =
              'none';


            document
              .getElementById('success-title')
              .textContent =
              'Fabrication Approved';


            document
              .getElementById('success-message')
              .textContent =
              'Thank you. Your approval for Order ' +
              order +
              ' has been received.';


            document
              .getElementById('success-screen')
              .style.display =
              'block';


          },
          750
        );


      }
    );



  /* =========================================================
     SHOW MODIFICATIONS
     ========================================================= */

  document
    .getElementById('show-modify-button')
    .addEventListener(
      'click',
      function () {


        document
          .getElementById('review-screen')
          .style.display =
          'none';


        document
          .getElementById('modify-screen')
          .style.display =
          'block';


      }
    );



  /* =========================================================
     BACK TO REVIEW
     ========================================================= */

  document
    .getElementById('back-to-review')
    .addEventListener(
      'click',
      function () {


        document
          .getElementById('modify-screen')
          .style.display =
          'none';


        document
          .getElementById('review-screen')
          .style.display =
          'block';


      }
    );



  /* =========================================================
     SUBMIT MODIFICATIONS
     ========================================================= */

  document
    .getElementById('submit-modifications')
    .addEventListener(
      'click',
      function () {


        const modifications =
          document
            .getElementById('modifications')
            .value
            .trim();



        if (!modifications) {


          alert(
            'Please enter the modifications you would like us to make.'
          );


          return;

        }



        const button =
          this;


        button.disabled =
          true;


        button.textContent =
          'Submitting...';



        submitToZapier(
          'modify',
          modifications
        );



        setTimeout(
          function () {


            document
              .getElementById('modify-screen')
              .style.display =
              'none';


            document
              .getElementById('review-screen')
              .style.display =
              'none';


            document
              .getElementById('success-title')
              .textContent =
              'Changes Requested';


            document
              .getElementById('success-message')
              .textContent =
              'Thank you. Your requested changes for Order ' +
              order +
              ' have been submitted.';


            document
              .getElementById('success-screen')
              .style.display =
              'block';


          },
          750
        );


      }
    );



  /* =========================================================
     INITIALIZE PAGE
     ========================================================= */

  renderItems();


  document
    .getElementById('loading')
    .style.display =
    'none';



  /*
    If customer clicked MODIFY in email,
    take them directly to modification screen.

    Otherwise show full review screen.
  */

  if (
    requestedAction === 'modify'
  ) {


    document
      .getElementById('modify-screen')
      .style.display =
      'block';


  }

  else {


    document
      .getElementById('review-screen')
      .style.display =
      'block';


  }


});
</script>


