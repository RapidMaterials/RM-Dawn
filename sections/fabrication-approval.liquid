<div style="max-width:700px;margin:60px auto;padding:30px;font-family:Arial,sans-serif;">

  <div id="loading">
    Loading fabrication approval...
  </div>


  <!-- APPROVAL SCREEN -->
  <div id="approved-screen" style="display:none;text-align:center;">

    <h1>Fabrication Approval</h1>

    <p>
      You are approving the fabrication details for
      <strong>Order <span class="order-number"></span></strong>.
    </p>

    <p>
      Please confirm that all fabrication details and dimensions are correct.
    </p>

    <button
      type="button"
      id="approve-button"
      style="
        background:#2f6f3e;
        color:#fff;
        border:0;
        padding:14px 28px;
        font-size:16px;
        font-weight:bold;
        cursor:pointer;
        border-radius:4px;
      ">
      Confirm Approval
    </button>

  </div>



  <!-- MODIFY SCREEN -->
  <div id="modify-screen" style="display:none;">

    <h1>Request Fabrication Changes</h1>

    <p>
      Order <strong><span class="order-number"></span></strong>
    </p>

    <p>
      Please describe the changes you would like us to make:
    </p>

    <textarea
      id="modifications"
      rows="7"
      style="
        width:100%;
        box-sizing:border-box;
        padding:12px;
        font-size:15px;
        border:1px solid #ccc;
        border-radius:4px;
      "
      placeholder="Enter requested modifications here..."
    ></textarea>

    <br><br>

    <button
      type="button"
      id="modify-button"
      style="
        background:#444;
        color:#fff;
        border:0;
        padding:14px 28px;
        font-size:16px;
        font-weight:bold;
        cursor:pointer;
        border-radius:4px;
      ">
      Submit Modifications
    </button>

  </div>



  <!-- SUCCESS SCREEN -->
  <div id="success-screen" style="display:none;text-align:center;">

    <h1 id="success-title"></h1>

    <p id="success-message"></p>

  </div>



  <!-- ERROR SCREEN -->
  <div id="error-screen" style="display:none;text-align:center;">

    <h1>Something Went Wrong</h1>

    <p>
      We were unable to submit your response. Please contact Rapid Materials.
    </p>

  </div>


  <!--
      Hidden iframe receives Zapier's response.
      This prevents the customer from leaving the Rapid Materials page.
  -->
  <iframe
    name="zapier-response"
    id="zapier-response"
    style="display:none;"
  ></iframe>


  <!--
      Hidden form that actually posts the response to Zapier.
  -->
  <form
    id="zapier-form"
    action="https://hooks.zapier.com/hooks/catch/21037350/4hmzwbn/"
    method="POST"
    target="zapier-response"
    style="display:none;"
  >

    <input
      type="hidden"
      name="action"
      id="zapier-action"
      value=""
    >

    <input
      type="hidden"
      name="order_number"
      id="zapier-order-number"
      value=""
    >

    <input
      type="hidden"
      name="modifications"
      id="zapier-modifications"
      value=""
    >

  </form>

</div>



<script>

document.addEventListener('DOMContentLoaded', function () {


  /* =========================================================
     READ URL VARIABLES
     ========================================================= */

  const params = new URLSearchParams(window.location.search);

  const order = params.get('order');
  const action = params.get('action');



  /* =========================================================
     VALIDATE ORDER NUMBER
     ========================================================= */

  if (!order) {

    document.getElementById('loading').style.display = 'none';

    document.getElementById('error-screen').style.display = 'block';

    return;

  }



  /* =========================================================
     DISPLAY ORDER NUMBER
     ========================================================= */

  document.querySelectorAll('.order-number').forEach(function(el) {

    el.textContent = order;

  });


  document.getElementById('loading').style.display = 'none';



  /* =========================================================
     SHOW CORRECT SCREEN
     ========================================================= */

  if (action === 'approved') {

    document.getElementById('approved-screen').style.display = 'block';

  }

  else if (action === 'modify') {

    document.getElementById('modify-screen').style.display = 'block';

  }

  else {

    document.getElementById('error-screen').style.display = 'block';

  }



  /* =========================================================
     SUBMIT TO ZAPIER
     ========================================================= */

  function submitToZapier(actionValue, modificationsValue) {

    document.getElementById('zapier-action').value =
      actionValue;

    document.getElementById('zapier-order-number').value =
      order;

    document.getElementById('zapier-modifications').value =
      modificationsValue || '';

    document.getElementById('zapier-form').submit();

  }



  /* =========================================================
     APPROVAL
     ========================================================= */

  document.getElementById('approve-button').addEventListener(
    'click',
    function () {

      const button = this;

      button.disabled = true;
      button.textContent = 'Submitting...';


      submitToZapier(
        'approved',
        ''
      );


      /*
       Give the browser a moment to submit the hidden form
       before showing confirmation.
      */

      setTimeout(function () {

        document.getElementById('approved-screen').style.display =
          'none';

        document.getElementById('success-title').textContent =
          'Fabrication Approved';

        document.getElementById('success-message').textContent =
          'Thank you. Your approval for Order ' +
          order +
          ' has been received.';

        document.getElementById('success-screen').style.display =
          'block';

      }, 750);

    }
  );



  /* =========================================================
     MODIFICATIONS
     ========================================================= */

  document.getElementById('modify-button').addEventListener(
    'click',
    function () {

      const modifications =
        document.getElementById('modifications').value.trim();


      if (!modifications) {

        alert(
          'Please enter the modifications you would like us to make.'
        );

        return;

      }


      const button = this;

      button.disabled = true;
      button.textContent = 'Submitting...';


      submitToZapier(
        'modify',
        modifications
      );


      setTimeout(function () {

        document.getElementById('modify-screen').style.display =
          'none';

        document.getElementById('success-title').textContent =
          'Changes Requested';

        document.getElementById('success-message').textContent =
          'Thank you. Your requested changes for Order ' +
          order +
          ' have been submitted.';

        document.getElementById('success-screen').style.display =
          'block';

      }, 750);

    }
  );


});

</script>



{% schema %}
{
  "name": "Fabrication Approval",
  "settings": [],
  "presets": [
    {
      "name": "Fabrication Approval"
    }
  ]
}
{% endschema %}