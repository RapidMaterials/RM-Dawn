{%- comment -%}
  SECTION: Collection Feature Icons (Metaobject reference)

  Collection metafield:
    collection.metafields.custom.features  (TYPE: metaobject reference)

  The referenced metaobject (your "icf" container) should have:
    - a field that is a LIST of feature metaobjects (default assumed id: "features")
      Each feature metaobject item should have:
        - icon (file/image)
        - headline (text)
        - sub_headline (text, optional)

  If your container field id is NOT "features", change:
    assign iconfs = icf_container.features.value
  to match your actual field id.

  Tip (optional debug):
    <pre>{{ icf_container | json }}</pre>
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-icon-features-{{ section.id }} {
    {% if section.settings.use_background %}
      background: {{ section.settings.background_color }};
    {% endif %}
  }

  .collection-icon-features-{{ section.id }} .icon-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ section.settings.min_col_width }}px, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }

  .collection-icon-features-{{ section.id }} .icon-feature {
    text-align: center;
  }

  .collection-icon-features-{{ section.id }} .icon-feature__image {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  .collection-icon-features-{{ section.id }} .icon-feature__title {
    margin: 0;
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .collection-icon-features-{{ section.id }} .icon-feature__subtitle {
    margin: 0.25rem 0 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }
{%- endstyle -%}

{%- assign icf_container = collection.metafields.custom.features.value -%}
{% assign compatible_collections = collection.metafields.custom.compatible_collections.value %}

{%- comment -%}
  IMPORTANT: change ".features" below if your container field id is different
  (example: icf_container.icon_features.value, icf_container.items.value, etc.)
{%- endcomment -%}
{%- assign iconfs = blank -%}
{%- if icf_container != blank -%}
  {%- assign iconfs = icf_container.features.value -%}
{%- endif -%}

{%- if collection != blank and iconfs != blank -%}
  <section class="collection-icon-features-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
    <div class="{% if section.settings.full_width %}page-width{% else %}page-width{% endif %}">
      {%- if section.settings.heading != blank -%}
        <h2 class="title title--primary" style="margin-top:0;">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <ul class="icon-features-list">
        {%- for icf in iconfs -%}
          <li class="icon-feature">
            {%- if icf.icon.value != blank -%}
              <img
                src="{{ icf.icon.value | image_url: width: 128 }}"
                alt="{{ icf.headline.value | default: section.settings.default_alt | escape }}"
                class="icon-feature__image"
                loading="lazy"
              >
            {%- endif -%}

            {%- if icf.headline.value != blank -%}
              <h3 class="icon-feature__title">{{ icf.headline.value }}</h3>
            {%- endif -%}

            {%- if icf.sub_headline.value != blank -%}
              <p class="icon-feature__subtitle">{{ icf.sub_headline.value }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection Icons",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (optional)",
      "default": "Key Features"
    },
    {
      "type": "text",
      "id": "default_alt",
      "label": "Fallback image alt text",
      "default": "Feature icon"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_background",
      "label": "Enable background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#d9d9d9"
    },
    {
      "type": "range",
      "id": "min_col_width",
      "min": 120,
      "max": 340,
      "step": 10,
      "unit": "px",
      "label": "Min column width",
      "default": 160
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Icons"
    }
  ]
}
{% endschema %}
