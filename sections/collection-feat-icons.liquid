{%- comment -%}
  Collection Icons (supports multiple metafield shapes)

  Collection metafield:
    collection.metafields.custom.features

  Supported shapes:
    A) LIST of feature metaobjects (icon/headline/sub_headline)
    B) SINGLE "container" metaobject that has a LIST field like:
       - features
       - items
       - icon_features
    C) SINGLE feature metaobject (icon/headline/sub_headline)
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-icon-features-{{ section.id }} {
    {% if section.settings.use_background %}
      background: {{ section.settings.background_color }};
    {% endif %}
  }

  .collection-icon-features-{{ section.id }} .icon-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ section.settings.min_col_width }}px, 160px));
        justify-content: center;
    gap: {{ section.settings.grid_gap }}px;
  }

  .collection-icon-features-{{ section.id }} .icon-feature {
    text-align: center;
  }

  

  .collection-icon-features-{{ section.id }} .icon-feature__image {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  .collection-icon-features-{{ section.id }} .icon-feature__title {
    margin: 0;
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .collection-icon-features-{{ section.id }} .icon-feature__subtitle {
    margin: 0.25rem 0 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .collection-icon-features-{{ section.id }} .debug-box {
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid rgba(0,0,0,.15);
    background: rgba(0,0,0,.03);
    overflow: auto;
    max-width: 100%;
  }
  @media screen and (max-width: 749px) {
  p.icon-feature__subtitle {
    font-size: 0.6em !important;
  }
  h3.icon-feature__title {
    font-size: 0.8em !important;
    font-weight: 600 !important;
  }
  .collection-icon-features-{{ section.id }} .icon-features-list {
    grid-template-columns: repeat(auto-fit, minmax(100px, 160px)) !important;
        gap: 8px !important;
  }
}
{%- endstyle -%}

{%- assign raw = collection.metafields.custom.features -%}
{%- assign val = raw.value -%}

{%- assign iconfs = blank -%}

{%- comment -%}
  Try to normalize into "iconfs" as a LIST of feature metaobjects.
{%- endcomment -%}

{%- if val == blank -%}
  {%- assign iconfs = blank -%}

{%- elsif val.size != blank -%}
  {%- comment -%} A) val is an array/list (LIST metafield) {%- endcomment -%}
  {%- assign iconfs = val -%}

{%- else -%}
  {%- comment -%}
    val is a single metaobject reference.
    It could be:
      B) a container with a list field, OR
      C) a single feature item itself.
  {%- endcomment -%}

  {%- if val.features and val.features.value != blank -%}
    {%- assign iconfs = val.features.value -%}
  {%- elsif val.items and val.items.value != blank -%}
    {%- assign iconfs = val.items.value -%}
  {%- elsif val.icon_features and val.icon_features.value != blank -%}
    {%- assign iconfs = val.icon_features.value -%}
  {%- else -%}
    {%- comment -%} C) assume this *is* a single feature item {%- endcomment -%}
    {%- capture single_item_json -%}[{{ val | json }}]{%- endcapture -%}
    {%- assign iconfs = single_item_json | parse_json -%}
  {%- endif -%}
{%- endif -%}

{%- if iconfs != blank -%}
  <section class="collection-icon-features-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="title title--primary" style="margin-top:0;">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <ul class="icon-features-list">
        {%- for icf in iconfs -%}
          <li class="icon-feature">
            {%- if icf.icon and icf.icon.value != blank -%}
              <img
                src="{{ icf.icon.value | image_url: width: 128 }}"
                alt="{{ icf.headline.value | default: section.settings.default_alt | escape }}"
                class="icon-feature__image"
                loading="lazy"
              >
            {%- endif -%}

            {%- if icf.headline and icf.headline.value != blank -%}
              <h3 class="icon-feature__title">{{ icf.headline.value }}</h3>
            {%- endif -%}

            {%- if icf.sub_headline and icf.sub_headline.value != blank -%}
              <p class="icon-feature__subtitle">{{ icf.sub_headline.value }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.debug -%}
        <div class="debug-box">
          <strong>DEBUG:</strong><br>
          <div><em>collection.metafields.custom.features</em></div>
          <pre>{{ raw | json }}</pre>
          <div><em>raw.value</em></div>
          <pre>{{ val | json }}</pre>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  {%- if section.settings.debug -%}
    <section class="section-{{ section.id }}-padding">
      <div class="page-width">
        <div class="debug-box">
          <strong>DEBUG (blank output):</strong><br>
          <div><em>collection.metafields.custom.features</em></div>
          <pre>{{ collection.metafields.custom.features | json }}</pre>
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection Icons",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (optional)",
      "default": "Key Features"
    },
    {
      "type": "text",
      "id": "default_alt",
      "label": "Fallback image alt text",
      "default": "Feature icon"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_background",
      "label": "Enable background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#d9d9d9"
    },
    {
      "type": "range",
      "id": "min_col_width",
      "min": 120,
      "max": 340,
      "step": 10,
      "unit": "px",
      "label": "Min column width",
      "default": 160
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "debug",
      "label": "Debug output",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Collection Icons"
    }
  ]
}
{% endschema %}
