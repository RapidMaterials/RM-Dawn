{%- style -%}
.header{
  display:flex;
}


  .rm-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
  }

  /* Height controls */
  .rm-banner-{{ section.id }} .rm-banner__media {
    position: relative;
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
  }

  @media screen and (max-width: 749px) {
    .rm-banner-{{ section.id }} .rm-banner__media {
      height: {{ section.settings.mobile_height }}px;
    }
  }

  /* Background image fill */
  .rm-banner-{{ section.id }} .rm-banner__bg img {
     position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.object_fit }};
  object-position: {{ section.settings.desktop_object_x }}% {{ section.settings.desktop_object_y }}%;
  display: block;
}

@media screen and (max-width: 749px) {
  .rm-banner-{{ section.id }} .rm-banner__bg img {
    object-position: {{ section.settings.mobile_object_x }}% {{ section.settings.mobile_object_y }}%;
  }
}

  /* Optional link wrapper */
  .rm-banner-{{ section.id }} a.rm-banner__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Overlay container (centered) */
  .rm-banner-{{ section.id }} .rm-banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; /* allow whole banner to remain clickable */
    padding: 16px;
    z-index: 2;
  }
  .rm-banner-{{ section.id }} .rm-banner__bg {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.rm-banner-{{ section.id }} .rm-banner__overlay {
  z-index: 1;
}

nav.header__inline-menu{
  margin-top:0 !important;
}

  /* Optional glow/blur circle */
  .rm-banner-{{ section.id }} .rm-banner__glow {
    position: absolute;
    width: {{ section.settings.glow_width_desktop }}px;
    height: {{ section.settings.glow_height_desktop }}px;
    border-radius: 999px;
    filter: blur({{ section.settings.glow_blur }}px);
    opacity: {{ section.settings.glow_opacity | times: 0.01 }};
    z-index: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  @media screen and (max-width: 749px) {
    .rm-banner-{{ section.id }} .rm-banner__glow {
      width: {{ section.settings.glow_width_mobile }}px;
      height: {{ section.settings.glow_height_mobile }}px;
    }
  }

  .rm-banner-{{ section.id }} .rm-banner__glow--white {
    background: radial-gradient(circle, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.0) 65%);
    display: inline;
  }
  .rm-banner-{{ section.id }} .rm-banner__glow--black {
    background: radial-gradient(circle, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.0) 65%);
    display: inline;
  }

  /* Overlay image sizing */
  .rm-banner-{{ section.id }} .rm-banner__logo-wrap {
    position: relative;
    z-index: 2;
    width: {{ section.settings.logo_width_desktop }}px;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .rm-banner-{{ section.id }} .rm-banner__logo-wrap {
      width: {{ section.settings.logo_width_mobile }}px;
    }
  }

  .rm-banner-{{ section.id }} .rm-banner__logo-wrap img {
    position: static;
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
{%- endstyle -%}

<div class="rm-banner-{{ section.id }}">
  {%- if section.settings.link != blank -%}
    <a class="rm-banner__link" href="{{ section.settings.link }}">
  {%- endif -%}

  <div class="rm-banner__media">
    {%- liquid
      assign desktop_img = section.settings.desktop_image
      assign mobile_img = section.settings.mobile_image
      assign use_mobile = false
      if mobile_img != blank
        assign use_mobile = true
      endif
    -%}

    <div class="rm-banner__bg">
      {%- if desktop_img != blank -%}
        <picture>
          {%- if use_mobile -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_img | image_url: width: 1500 }}"
            >
          {%- endif -%}

          <img
            src="{{ desktop_img | image_url: width: 3000 }}"
            alt="{{ section.settings.alt_text | escape }}"
            loading="{{ section.settings.loading }}"
            width="{{ desktop_img.width }}"
            height="{{ desktop_img.height }}"
          >
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if section.settings.logo_image != blank -%}
      <div class="rm-banner__overlay">
        {%- if section.settings.show_glow -%}
          <div
            class="rm-banner__glow rm-banner__glow--{{ section.settings.glow_color }}"
            aria-hidden="true"
          ></div>
        {%- endif -%}

        <div class="rm-banner__logo-wrap">
          <img
            src="{{ section.settings.logo_image | image_url: width: 1200 }}"
            alt="{{ section.settings.logo_alt | escape }}"
            loading="lazy"
          >
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.link != blank -%}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Simple Banner Image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt text",
      "default": "Banner image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
      {
        "type": "header",
        "content": "Background position (desktop)"
      },
      {
        "type": "range",
        "id": "desktop_object_x",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Horizontal position (desktop)",
        "default": 50
      },
      {
        "type": "range",
        "id": "desktop_object_y",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Vertical position (desktop)",
        "default": 50
      },
      {
        "type": "header",
        "content": "Background position (mobile)"
      },
      {
        "type": "range",
        "id": "mobile_object_x",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Horizontal position (mobile)",
        "default": 50
      },
      {
        "type": "range",
        "id": "mobile_object_y",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Vertical position (mobile)",
        "default": 50
      },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 100,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Desktop height",
      "default": 420
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 100,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Mobile height",
      "default": 260
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover (recommended)" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "loading",
      "label": "Loading",
      "default": "lazy",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ]
    },

    {
      "type": "header",
      "content": "Overlay logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Overlay logo image"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "min": 60,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Logo width (desktop)",
      "default": 280
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 40,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Logo width (mobile)",
      "default": 180
    },

    {
      "type": "header",
      "content": "Glow behind logo (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show glow",
      "default": false
    },
    {
      "type": "select",
      "id": "glow_color",
      "label": "Glow color",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" }
      ]
    },
    {
      "type": "range",
      "id": "glow_opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Glow opacity",
      "default": 45
    },
    {
      "type": "range",
      "id": "glow_blur",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Glow blur",
      "default": 26
    },
    {
      "type": "range",
      "id": "glow_height_desktop",
      "min": 80,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Glow Height (desktop)",
      "default": 380
    },
     {
      "type": "range",
      "id": "glow_width_desktop",
      "min": 80,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Glow Width (desktop)",
      "default": 380
    },
    {
      "type": "range",
      "id": "glow_height_mobile",
      "min": 80,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Glow Height (mobile)",
      "default": 260
    },
     {
      "type": "range",
      "id": "glow_width_mobile",
      "min": 80,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Glow Width (mobile)",
      "default": 380
    }
  ],
  "presets": [
    {
      "name": "Simple Banner Image"
    }
  ]
}
{% endschema %}