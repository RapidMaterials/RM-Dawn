{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding .video-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-{{ section.id }}-padding .video-gallery__item {
    flex: 1 1 calc(33.333% - 1rem);
    position: relative;
    max-width: calc(33.333% - 0.667rem);
  }

  .section-{{ section.id }}-padding .video-gallery__thumb {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    z-index: 1;
  }

  /*
   * Gallery thumbnails remain landscape.
   * This only affects the image shown before the video opens.
   */
  .section-{{ section.id }}-padding .video-gallery__thumb img,
  .section-{{ section.id }}-padding .video-gallery__thumb svg {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .section-{{ section.id }}-padding .video-play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .section-{{ section.id }}-padding .video-play-button::before {
    content: '';
    display: block;
    width: 0;
    height: 0;
    margin-left: 4px;
    border-left: 18px solid white;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
  }

  .video-lightbox[data-section-id="{{ section.id }}"] {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 55px 20px 20px;
    background: rgba(0, 0, 0, 0.8);
    z-index: 2147483647 !important;
    display: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    overflow: auto;
  }

  .video-lightbox[data-section-id="{{ section.id }}"].is-open {
    display: flex;
  }

.video-lightbox[data-section-id="{{ section.id }}"] .video-lightbox__content {
  position: relative;
  width: auto;
  max-width: 90vw;
  max-height: 85vh;
  margin: auto;
}

  .video-lightbox[data-section-id="{{ section.id }}"] .video-lightbox__close {
    position: absolute;
    top: -45px;
    right: 0;
    z-index: 2;
    padding: 0;
    width: 36px;
    height: 36px;
    font-size: 2.5rem;
    line-height: 1;
    background: none;
    color: white;
    border: none;
    cursor: pointer;
  }

  /*
   * JavaScript updates the content width based on the actual
   * embed ratio. The fallback is 16:9.
   */
.video-lightbox[data-section-id="{{ section.id }}"] .video-container {
  width: min(
    90vw,
    calc(80vh * var(--video-aspect-ratio, 1.777777))
  );
  max-width: 1000px;
  max-height: 80vh;
  margin: 0 auto;
}

  /*
   * Do not force all videos to 16:9 here.
   * JavaScript applies the correct width and height for each embed.
   */
 .video-lightbox[data-section-id="{{ section.id }}"] .video-container iframe,
.video-lightbox[data-section-id="{{ section.id }}"] .video-container video {
  display: block;
  width: 100% !important;
  height: auto !important;
  aspect-ratio: var(--video-aspect-ratio, 16 / 9);
  max-width: 100% !important;
  max-height: 80vh !important;
  object-fit: contain;
  border: 0;
}

  /*
   * Standard YouTube and Vimeo embeds created by this section.
   * JavaScript may override these dimensions when needed.
   */
  .video-lightbox[data-section-id="{{ section.id }}"] .video-container > iframe {
    width: 100%;
  }

  /*
   * Facebook and Instagram wrapper elements.
   */
.video-lightbox[data-section-id="{{ section.id }}"] .video-container .fb-video,
.video-lightbox[data-section-id="{{ section.id }}"] .video-container .fb-post,
.video-lightbox[data-section-id="{{ section.id }}"] .video-container .instagram-media,
.video-lightbox[data-section-id="{{ section.id }}"] .video-container blockquote {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 auto !important;
}
  .video-lightbox[data-section-id="{{ section.id }}"] .video-container .fb-video iframe,
  .video-lightbox[data-section-id="{{ section.id }}"] .video-container .fb-post iframe,
  .video-lightbox[data-section-id="{{ section.id }}"] .video-container .instagram-media iframe {
    display: block;
    max-width: 90vw !important;
    max-height: 85vh !important;
    margin: 0 auto;
  }

  body.video-lightbox-open {
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding .video-gallery__item {
      flex-basis: 100%;
      max-width: 100%;
    }

    .video-lightbox[data-section-id="{{ section.id }}"] {
      padding: 50px 10px 15px;
    }

    .video-lightbox[data-section-id="{{ section.id }}"] .video-lightbox__content {
      width: auto;
      max-width: calc(100vw - 20px);
      max-height: calc(100vh - 70px);
    }

    .video-lightbox[data-section-id="{{ section.id }}"] .video-container {
      width: min(
        calc(100vw - 20px),
        calc(80vh * var(--video-aspect-ratio, 1.777777))
      );
      max-width: calc(100vw - 20px);
      max-height: 80vh;
    }

    .video-lightbox[data-section-id="{{ section.id }}"] .video-container iframe,
    .video-lightbox[data-section-id="{{ section.id }}"] .video-container video,
    .video-lightbox[data-section-id="{{ section.id }}"] .video-container .fb-video,
    .video-lightbox[data-section-id="{{ section.id }}"] .video-container .fb-post,
    .video-lightbox[data-section-id="{{ section.id }}"] .video-container .instagram-media,
    .video-lightbox[data-section-id="{{ section.id }}"] .video-container blockquote {
      max-width: calc(100vw - 20px) !important;
      max-height: 80vh !important;
    }
  }
{% endstyle %}

<div
  class="
    color-{{ section.settings.color_scheme }}
    gradient
    {{ section.settings.section_float }}
    section-{{ section.id }}-padding
  "
  data-video-gallery-section="{{ section.id }}"
>
  <div class="video-section isolate{% unless section.settings.full_width %} page-width{% endunless %}">
    {%- unless section.settings.heading == blank -%}
      <div
        class="
          title-wrapper
          title-wrapper--no-top-margin
          {% if settings.animations_reveal_on_scroll %}
            scroll-trigger animate--slide-in
          {% endif %}
        "
      >
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endunless -%}

    <div class="video-gallery">
      {%- assign vids = product.metafields.custom.videos.value -%}

      {%- if vids == blank and collection -%}
        {%- assign vids = collection.metafields.custom.videos.value -%}
      {%- endif -%}

      {%- if vids == blank and page -%}
        {%- assign vids = page.metafields.custom.videos.value -%}
      {%- endif -%}

      {%- if vids != blank -%}
        {%- for videos in vids -%}
          {%- assign embed_code = videos.embed_code.value | default: videos.embed_code -%}
          {%- assign raw_url = videos.video_url.value | default: videos.video_url -%}
          {%- assign video_type = videos.video_url.provider | default: videos.video_url.type -%}
          {%- assign video_id = videos.video_url.id -%}
          {%- assign alt = videos.video_description.value | default: videos.video_description -%}
          {%- assign poster = videos.poster_image.value | default: videos.poster_image -%}

          {%- if video_id == blank and raw_url != blank -%}
            {%- if raw_url contains 'youtu.be/' -%}
              {%- assign video_id_with_params = raw_url | split: 'youtu.be/' | last -%}
              {%- assign video_id = video_id_with_params | split: '?' | first -%}
              {%- assign video_type = 'youtube' -%}

            {%- elsif raw_url contains 'youtube.com/watch' -%}
              {%- assign video_id_with_params = raw_url | split: 'v=' | last -%}
              {%- assign video_id = video_id_with_params | split: '&' | first -%}
              {%- assign video_type = 'youtube' -%}

            {%- elsif raw_url contains 'youtube.com/shorts/' -%}
              {%- assign video_id_with_params = raw_url | split: 'youtube.com/shorts/' | last -%}
              {%- assign video_id = video_id_with_params | split: '?' | first -%}
              {%- assign video_type = 'youtube' -%}

            {%- elsif raw_url contains 'youtube.com/embed/' -%}
              {%- assign video_id_with_params = raw_url | split: 'youtube.com/embed/' | last -%}
              {%- assign video_id = video_id_with_params | split: '?' | first -%}
              {%- assign video_type = 'youtube' -%}

            {%- elsif raw_url contains 'vimeo.com/' -%}
              {%- assign video_id_with_params = raw_url | split: '/' | last -%}
              {%- assign video_id = video_id_with_params | split: '?' | first -%}
              {%- assign video_type = 'vimeo' -%}
            {%- endif -%}
          {%- endif -%}

          {%- assign embed_template_id = 'video-embed-' | append: section.id | append: '-metafield-' | append: forloop.index -%}

          {%- if embed_code != blank or video_id != blank -%}
            <div class="video-gallery__item">
              <button
                type="button"
                class="video-gallery__thumb"
                {% if embed_code != blank %}
                  data-embed-template="{{ embed_template_id }}"
                {% else %}
                  data-video-type="{{ video_type | downcase }}"
                  data-video-id="{{ video_id | escape }}"
                {% endif %}
                aria-label="{{ alt | default: 'Play video' | escape }}"
              >
                {%- if poster != blank -%}
                  {{
                    poster
                    | image_url: width: 1000
                    | image_tag:
                      alt: alt,
                      loading: 'lazy',
                      widths: '360, 480, 640, 800, 1000',
                      sizes: '(min-width: 750px) 33vw, 100vw'
                  }}
                {%- elsif video_type == 'youtube' and video_id != blank -%}
                  <img
                    src="https://i.ytimg.com/vi/{{ video_id | escape }}/hqdefault.jpg"
                    alt="{{ alt | default: 'Play video' | escape }}"
                    width="480"
                    height="360"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}

                <span class="video-play-button" aria-hidden="true"></span>
              </button>

              {%- if embed_code != blank -%}
                <template id="{{ embed_template_id }}">
                  {{ embed_code }}
                </template>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign embed_code = block.settings.embed_code -%}
        {%- assign video_id = block.settings.video_url.id -%}
        {%- assign video_type = block.settings.video_url.type -%}
        {%- assign alt = block.settings.alt_text -%}
        {%- assign poster = block.settings.poster_image -%}
        {%- assign embed_template_id = 'video-embed-' | append: section.id | append: '-block-' | append: block.id -%}

        {%- if embed_code != blank or video_id != blank -%}
          <div
            class="video-gallery__item"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="video-gallery__thumb"
              {% if embed_code != blank %}
                data-embed-template="{{ embed_template_id }}"
              {% else %}
                data-video-type="{{ video_type }}"
                data-video-id="{{ video_id | escape }}"
              {% endif %}
              aria-label="{{ alt | default: 'Play video' | escape }}"
            >
              {%- if poster != blank -%}
                {{
                  poster
                  | image_url: width: 1000
                  | image_tag:
                    alt: alt,
                    loading: 'lazy',
                    widths: '360, 480, 640, 800, 1000',
                    sizes: '(min-width: 750px) 33vw, 100vw'
                }}
              {%- elsif video_type == 'youtube' and video_id != blank -%}
                <img
                  src="https://i.ytimg.com/vi/{{ video_id | escape }}/hqdefault.jpg"
                  alt="{{ alt | default: 'Play video' | escape }}"
                  width="480"
                  height="360"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              {%- endif -%}

              <span class="video-play-button" aria-hidden="true"></span>
            </button>

            {%- if embed_code != blank -%}
              <template id="{{ embed_template_id }}">
                {{ embed_code }}
              </template>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div
      class="video-lightbox"
      data-section-id="{{ section.id }}"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label="Video player"
    >
      <div class="video-lightbox__content">
        <button
          type="button"
          class="video-lightbox__close"
          aria-label="Close video"
        >
          ×
        </button>

        <div class="video-container"></div>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const sectionId = '{{ section.id }}';

    function initializeVideoGallery() {
      const section = document.querySelector(
        `[data-video-gallery-section="${sectionId}"]`
      );

      if (!section || section.dataset.videoGalleryInitialized === 'true') {
        return;
      }

      section.dataset.videoGalleryInitialized = 'true';

      const buttons = section.querySelectorAll('.video-gallery__thumb');
      const lightbox = section.querySelector(
        `.video-lightbox[data-section-id="${sectionId}"]`
      );

      if (!lightbox) return;

      const container = lightbox.querySelector('.video-container');
      const closeButton = lightbox.querySelector('.video-lightbox__close');

      if (!container || !closeButton) return;

      document.body.appendChild(lightbox);

      let scrollPosition = 0;
      let lastFocusedElement = null;
      let embedObserver = null;

      function runEmbedScripts(element) {
        const scripts = element.querySelectorAll('script');

        scripts.forEach((oldScript) => {
          const newScript = document.createElement('script');

          Array.from(oldScript.attributes).forEach((attribute) => {
            newScript.setAttribute(attribute.name, attribute.value);
          });

          newScript.textContent = oldScript.textContent;

          if (oldScript.parentNode) {
            oldScript.parentNode.replaceChild(newScript, oldScript);
          }
        });

        if (
          window.FB &&
          window.FB.XFBML &&
          typeof window.FB.XFBML.parse === 'function'
        ) {
          window.FB.XFBML.parse(element);
        }

        if (
          window.instgrm &&
          window.instgrm.Embeds &&
          typeof window.instgrm.Embeds.process === 'function'
        ) {
          window.instgrm.Embeds.process();
        }
      }

      function getNumberFromStyle(styleText, property) {
        if (!styleText) return null;

        const expression = new RegExp(
          `${property}\\s*:\\s*([0-9.]+)px`,
          'i'
        );

        const match = styleText.match(expression);

        return match ? parseFloat(match[1]) : null;
      }

      function getEmbedAspectRatio(html) {
        const temporaryWrapper = document.createElement('div');
        temporaryWrapper.innerHTML = html;

        const iframe = temporaryWrapper.querySelector('iframe');
        const video = temporaryWrapper.querySelector('video');
        const media = iframe || video;

        if (media) {
          const styleText = media.getAttribute('style') || '';

          const width =
            parseFloat(media.getAttribute('width')) ||
            getNumberFromStyle(styleText, 'width');

          const height =
            parseFloat(media.getAttribute('height')) ||
            getNumberFromStyle(styleText, 'height');

          if (width && height && width > 0 && height > 0) {
            return width / height;
          }

          const src = media.getAttribute('src') || '';

          if (
            src.includes('facebook.com') ||
            src.includes('instagram.com')
          ) {
            return 9 / 16;
          }
        }

        if (
          html.includes('instagram-media') ||
          html.includes('instagram.com') ||
          html.includes('facebook.com/reel') ||
          html.includes('facebook.com/plugins/video')
        ) {
          return 9 / 16;
        }

        return 16 / 9;
      }

      function applyMediaSizing() {
        const mediaElements = container.querySelectorAll('iframe, video');

        mediaElements.forEach((media) => {
          media.style.setProperty('display', 'block', 'important');
          media.style.setProperty('width', '100%', 'important');
          media.style.setProperty('height', 'auto', 'important');
          media.style.setProperty(
            'aspect-ratio',
            'var(--video-aspect-ratio)',
            'important'
          );
          media.style.setProperty('max-width', '100%', 'important');
          media.style.setProperty('max-height', '80vh', 'important');
          media.style.setProperty('border', '0', 'important');
          media.style.setProperty('object-fit', 'contain', 'important');

          media.removeAttribute('scrolling');
        });
      }

      function openLightbox(
        content,
        isEmbedCode = false,
        forcedRatio = null
      ) {
        scrollPosition = window.scrollY;
        lastFocusedElement = document.activeElement;

        let aspectRatio = forcedRatio;

        if (!aspectRatio) {
          aspectRatio = isEmbedCode
            ? getEmbedAspectRatio(content)
            : 16 / 9;
        }

        /*
         * Prevent broken or extreme embed dimensions from
         * creating an oversized popup.
         */
        if (
          !Number.isFinite(aspectRatio) ||
          aspectRatio < 0.45 ||
          aspectRatio > 2.4
        ) {
          aspectRatio = isEmbedCode ? 9 / 16 : 16 / 9;
        }

        container.style.setProperty(
          '--video-aspect-ratio',
          aspectRatio
        );

        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollPosition}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        document.body.classList.add('video-lightbox-open');

        container.innerHTML = content;

        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');

        applyMediaSizing();

        if (isEmbedCode) {
          runEmbedScripts(container);

          /*
           * Facebook and Instagram may insert or replace
           * the iframe after their script loads.
           */
          embedObserver = new MutationObserver(() => {
            applyMediaSizing();
          });

          embedObserver.observe(container, {
            childList: true,
            subtree: true
          });

          window.setTimeout(applyMediaSizing, 300);
          window.setTimeout(applyMediaSizing, 800);
          window.setTimeout(applyMediaSizing, 1500);
          window.setTimeout(applyMediaSizing, 3000);
        }

        closeButton.focus();
      }

      function closeLightbox() {
        if (embedObserver) {
          embedObserver.disconnect();
          embedObserver = null;
        }

        container.innerHTML = '';
        container.style.removeProperty('--video-aspect-ratio');

        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');

        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.width = '';
        document.body.classList.remove('video-lightbox-open');

        window.scrollTo(0, scrollPosition);

        if (lastFocusedElement) {
          lastFocusedElement.focus();
        }
      }

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const embedTemplateId = button.dataset.embedTemplate;

          /*
           * Embed code takes priority over the normal
           * YouTube or Vimeo URL.
           */
          if (embedTemplateId) {
            const template = document.getElementById(
              embedTemplateId
            );

            if (template) {
              openLightbox(
                template.innerHTML.trim(),
                true
              );
            }

            return;
          }

          const videoType = button.dataset.videoType;
          const videoId = button.dataset.videoId;

          if (!videoId) return;

          let iframeSrc = '';

          if (videoType === 'youtube') {
            iframeSrc =
              `https://www.youtube.com/embed/${encodeURIComponent(videoId)}` +
              '?autoplay=1&mute=1&enablejsapi=1&rel=0';
          } else if (videoType === 'vimeo') {
            iframeSrc =
              `https://player.vimeo.com/video/${encodeURIComponent(videoId)}` +
              '?autoplay=1';
          }

          if (!iframeSrc) return;

          const title =
            button.getAttribute('aria-label') || 'Video';

          openLightbox(
            `
              <iframe
                src="${iframeSrc}"
                title="${title.replace(/"/g, '&quot;')}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
              ></iframe>
            `,
            false,
            16 / 9
          );
        });
      });

      closeButton.addEventListener('click', closeLightbox);

      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (
          event.key === 'Escape' &&
          lightbox.classList.contains('is-open')
        ) {
          closeLightbox();
        }
      });

      document.addEventListener(
        'shopify:section:unload',
        (event) => {
          if (event.detail.sectionId === sectionId) {
            if (embedObserver) {
              embedObserver.disconnect();
            }

            lightbox.remove();
          }
        }
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        initializeVideoGallery,
        { once: true }
      );
    } else {
      initializeVideoGallery();
    }

    document.addEventListener(
      'shopify:section:load',
      (event) => {
        if (event.detail.sectionId === sectionId) {
          initializeVideoGallery();
        }
      }
    );
  })();
</script>
{% schema %}
{
  "name": "Multi Video Lightbox",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our Featured Videos",
      "label": "Section Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h0",
          "label": "Heading 0"
        },
        {
          "value": "hxl",
          "label": "Extra Large"
        },
        {
          "value": "hxxl",
          "label": "Double Extra Large"
        }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "select",
      "id": "section_float",
      "options": [
        {
          "value": "clear",
          "label": "None - Full Width"
        },
        {
          "value": "left",
          "label": "Float Left"
        },
        {
          "value": "right",
          "label": "Float Right"
        }
      ],
      "default": "clear",
      "label": "Float Option"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Video",
      "settings": [
        {
          "type": "video_url",
          "id": "video_url",
          "accept": [
            "youtube",
            "vimeo"
          ],
          "label": "Video URL",
          "info": "Used only when Embed Code is blank."
        },
        {
          "type": "liquid",
          "id": "embed_code",
          "label": "Embed Code",
          "info": "Overrides the Video URL when filled in. Paste a YouTube, Vimeo, Facebook, or other video embed code."
        },
